<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Claude Mate LaunchAgent
  ============================================================================
  This is a TEMPLATE. install.sh rewrites the __REPO__ and __PYTHON__
  placeholders with the real repository path and python3 interpreter before
  copying it into ~/Library/LaunchAgents/.

  Runs the daemon at login (RunAtLoad) and keeps it alive (KeepAlive) so the
  USB hardware companion reconnects automatically. Logs go to
  ~/Library/Logs/claude-mate.out.log and claude-mate.err.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudemate.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/daemon/claude_mate_daemon.py</string>
    </array>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart the daemon if it exits (e.g. USB unplugged then replugged). -->
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle restarts so a hard-failing daemon does not spin. -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Run from the repo so relative paths / mock helpers resolve sensibly. -->
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!--
      Unbuffer Python so logs are written promptly.

      THIS DICT IS ALSO HOW YOU TURN OPTIONS ON. ProgramArguments above carries
      no flags and is not meant to be hand-edited, so every `--flag` the daemon
      takes has a CLAUDE_MATE_* twin that belongs here instead:

          CLAUDE_MATE_TCP    1   serve the protocol over TCP  (--tcp)
          CLAUDE_MATE_BLE    1   serve it over Bluetooth LE   (--ble)
          CLAUDE_MATE_SOUND  1   macOS alert sounds           (--sound)
          CLAUDE_MATE_WEB    1   the browser game bridge      (--web)

      Add one, then `launchctl unload` and `load` this file. Note that --ble
      also needs `bleak` installed in the interpreter named above, and macOS
      Bluetooth permission granted to it -- a LaunchAgent cannot raise the
      prompt itself, so a refusal is silent. See firmware/README.md.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!--
          BLE ON BY DEFAULT, because every route the installer and the docs
          advertise for connecting a device runs through it: `claude-mate-connect
          --pair` needs it, and even USB token provisioning is gated behind a
          transport being enabled (a daemon with no radio has no secret to
          share). Shipping it off made a clean install unable to provision a
          device by either method it tells you about.

          It costs a daemon with no device nothing: bleak is imported lazily and
          a missing one is reported and carried on from, and a scan that finds
          nothing logs once every two minutes.
        -->
        <key>CLAUDE_MATE_BLE</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/claude-mate.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/claude-mate.err.log</string>

    <!-- Run only when the user is logged in (Aqua GUI session). -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
