#!/usr/bin/env python3
"""claude-mate -- do what the device does, from a terminal.

WHY THIS EXISTS. The device is the good interface: one screen, four buttons, and
it is looking at you. But it is one device, it is sometimes across the room, and
sometimes it is flat. Everything it can do is a line on the daemon's socket, so
none of that needed to be exclusive to the hardware -- it just never had a way
in from a terminal.

IT PRESSES THE SAME BUTTONS. `claude-mate go` sends `press|G`, which the daemon
hands to the SAME ButtonReader that handles `B|G` off the wire. So GO means
exactly one thing on this project: the mirror closes first, a double press
inside the window toggles FOLLOW, the raised window is the one whose name was on
the glass. There is no second implementation to drift.

  claude-mate                 the app: arrow keys, on a terminal
  claude-mate status          the queue, printed once (what a pipe gets)
  claude-mate watch           ...and keep printing it
  claude-mate next|prev       step the selection (or scroll the mirror)
  claude-mate go              ack + raise that session's terminal
  claude-mate ack             ack only, leave the window alone
  claude-mate follow          toggle FOLLOW (PREV/NEXT also raise)
  claude-mate mirror          toggle the terminal mirror
  claude-mate continue        type "continue" into that session
  claude-mate new-terminal    open a terminal in that session's directory
  claude-mate select <n|name> point at a row instead of stepping to it
  claude-mate accounts        the saved logins
  claude-mate accounts rm <name|n> delete one, after saying its name back
  claude-mate daemon          start (or restart) the daemon via launchd
  claude-mate --version       what this is

RUN IT WITH NO ARGUMENTS ON A TERMINAL and you get the app: the queue with the
arrow keys live in it, and a menu that starts a new session -- the wrapper with
`--dangerously-skip-permissions`, which is the thing you would otherwise type --
without leaving for a shell. Redirect it anywhere (a pipe, a hook, cron, a test)
and it is the same one-shot queue print it has always been, because a program
that changes shape depending on who is watching has to be obvious about which
shape is which.

WHAT IT DELIBERATELY DOES NOT DO OVER THE SOCKET. The socket is chmod 0600 --
owner-only, which is all a hook needs, since hooks run in your own shells. Even
so, deletion is not a daemon command: a hook firing a malformed line should not
be able to remove a login. `accounts rm` therefore does the deletion HERE, in
this process, and only asks the daemon to re-read afterwards.
"""
import json
import os
import shutil
import socket
import subprocess
import sys
import time

SOCK = os.environ.get("CLAUDE_MATE_SOCK", "/tmp/claude-mate.sock")

# Resolved through the SYMLINK, not around it. install.sh links this file into
# /usr/local/bin, so abspath() would put the sibling lookup in /usr/local/bin --
# where claude-mate-wrap is deliberately not linked (it is reached by shell
# alias, not by PATH). realpath() lands back in the repo, where the wrapper
# actually lives. claude-mate-switch had this exact bug and was broken for every
# installed user; it is fixed there too.
HERE = os.path.dirname(os.path.realpath(__file__))
WRAP = os.path.join(HERE, "claude-mate-wrap")
# The shared chooser lives beside this file. Through realpath for the same
# reason HERE is: this script is symlinked onto PATH, and the module is not.
if HERE not in sys.path:
    sys.path.insert(0, HERE)

# The LaunchAgent the installer sets up. Starting the daemon goes through
# launchd and never spawns python directly -- see start_daemon().
LAUNCHD_LABEL = "com.claudemate.daemon"
LAUNCHD_PLIST = os.path.expanduser(
    f"~/Library/LaunchAgents/{LAUNCHD_LABEL}.plist")

VERSION_FILE = os.path.join(os.path.dirname(HERE), "packaging", "VERSION")

B, D, OFF = "\033[1m", "\033[2m", "\033[0m"
COLOUR = {
    "error":   "\033[31m",
    "waiting": "\033[33m",
    "working": "\033[36m",
    "done":    "\033[32m",
    "idle":    "\033[2m",
}
if not sys.stdout.isatty():
    B = D = OFF = ""
    COLOUR = {k: "" for k in COLOUR}

# The device's own vocabulary, so the mapping is visible in one place rather than
# spread through the argument parser. See ButtonReader._dispatch.
PRESSES = {
    "prev": "P", "next": "N", "go": "G", "ack": "K", "follow": "F",
    "mirror": "M", "continue": "C", "new-terminal": "T",
}

# The app's single-key shortcuts, named as CLI VERBS rather than button codes so
# PRESSES above stays the only place a code is written down. (It is also the
# only place tools/test_cli.py looks: it scrapes that dict and insists every
# verb it finds is documented, and a second dict of codes here would have made
# it demand documentation for a keystroke.)
APP_KEYS = {"a": "ack", "f": "follow", "m": "mirror", "c": "continue"}


def talk(line, timeout=6.0):
    """One command, one reply. None means the daemon could not be reached."""
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(timeout)
        c.connect(SOCK)
        c.sendall((line + "\n").encode())
        c.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = c.recv(65536)
            if not chunk:
                break
            buf += chunk
        c.close()
        return buf.decode("utf-8", errors="replace")
    except OSError:
        return None


def die(msg, code=1):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def need(line):
    reply = talk(line)
    if reply is None:
        # NAME A COMMAND THAT WORKS. This used to say `launchctl bootstrap`,
        # which fails with "Bootstrap failed: 5: Input/output error" whenever
        # the job is already loaded -- i.e. on every machine that ran the
        # installer, which is every machine that has this file. See start_daemon().
        die(f"claude-mate: no daemon on {SOCK}\n"
            f"  start it:  claude-mate daemon")
    if reply.startswith("error:"):
        die(f"claude-mate: {reply.strip()[7:]}")
    return reply


def mmss(secs):
    return f"{int(secs) // 60}:{int(secs) % 60:02d}"


def read_version():
    """The packaged version, or a plain marker when running from a checkout."""
    try:
        with open(VERSION_FILE) as fh:
            return fh.read().strip() or "(unknown)"
    except OSError:
        return "(from a source checkout)"


def render(snap):
    """The queue, laid out like the glass: the shown row marked, alerts loud."""
    q = snap.get("queue", [])
    if not q:
        print(f"{D}no sessions. start one with `claude` in a project.{OFF}")
        return
    width = max(len(s["name"]) for s in q)
    for s in q:
        col = COLOUR.get(s["state"], "")
        # The two things the device says with a box and a flash: which row is on
        # the glass, and which rows are shouting.
        here = f"{B}>{OFF}" if s["shown"] else " "
        flag = "" if s["acked"] else f" {col}{B}<-- needs you{OFF}"
        right = "  ".join(x for x in (s["model"], s["effort"],
                                      s["account"], s["limit"]) if x)
        print(f" {here} {s['i']}  {col}{s['name']:<{width}}  "
              f"{s['state']:<7}{OFF} {mmss(s['secs']):>6}  {D}{right}{OFF}{flag}")
    if snap.get("follow"):
        print(f"\n {D}FOLLOW is on: prev/next also raise the terminal{OFF}")


def cmd_status(watch=False):
    while True:
        snap = json.loads(need("queue"))
        if watch and sys.stdout.isatty():
            # Full clear, not a scroll: this is a dashboard, and a screen that
            # accumulates history is one you have to read the bottom of.
            #
            # GUARDED, because this was the one place the "a pipe gets plain
            # text" contract leaked: the colours two dozen lines up are blanked
            # for a non-TTY and this escape was not, so `claude-mate watch | tee`
            # wrote a clear-screen into the file once a second.
            sys.stdout.write("\033[2J\033[H")
            print(f"{B}claude-mate{OFF}  {D}{time.strftime('%H:%M:%S')} "
                  f"· ctrl-c to stop{OFF}\n")
        render(snap)
        if not watch:
            return 0
        time.sleep(1.0)


def cmd_press(name):
    need(f"press|{PRESSES[name]}")
    # Show the result rather than announcing the action: what matters after a
    # `next` is which session is now under the cursor. ("select" used to be in
    # this tuple and could never match -- it is routed to cmd_select and is not
    # a key in PRESSES, so cmd_press never sees it.)
    if name in ("prev", "next", "follow"):
        render(json.loads(need("queue")))
    return 0


def cmd_select(want):
    reply = need(f"select|{want}")
    print(f"{D}{reply.strip()[3:]}{OFF}" if reply.startswith("ok ") else reply.strip())
    render(json.loads(need("queue")))
    return 0


def cmd_accounts(argv):
    snap = json.loads(need("accounts"))
    accts = snap["accounts"]
    if not argv:
        for i, a in enumerate(accts):
            email = read_email(a["name"], a["dir"])
            mark = "" if a["exists"] else f"  {D}(missing){OFF}"
            print(f"  {i}  {show_name(a['name']):<14} "
                  f"{D}{email or '(not logged in)'}{OFF}{mark}")
        print(f"\n{D}dir: {snap['accounts_dir']}{OFF}")
        print(f"{D}limits + switching: claude-mate-switch{OFF}")
        return 0
    if argv[0] not in ("rm", "remove", "delete"):
        die(f"claude-mate accounts: unknown subcommand {argv[0]!r}")
    if len(argv) < 2:
        # ASK, RATHER THAN SCOLD. "which account?" is a fair error at the end
        # of a pipe and a silly one at a terminal, where we already know the
        # list and the answer is one arrow key away. It is also the only way to
        # reach a profile whose name cannot be typed -- see show_name().
        if not supports_ui():
            die("claude-mate accounts rm: which account? "
                "(see `claude-mate accounts`)")
        items = []
        for i, a in enumerate(accts):
            if not a["removable"]:
                continue
            email = read_email(a["name"], a["dir"]) or "(not logged in)"
            items.append(Item(show_name(a["name"]) or "(blank)",
                              value=a["name"], detail=email))
        if not items:
            die("claude-mate accounts rm: no removable profiles")
        items.append(Item("Cancel", value=None, gap=True))
        want = pick("DELETE WHICH ACCOUNT?", items,
                    hint="↑↓ move   ⏎ choose   esc cancel")
        if want is None:
            print("not deleted.")
            return 1
    else:
        want = argv[1]
    match = [a for a in accts if a["name"] == want]
    if not match and want.isdigit() and 0 <= int(want) < len(accts):
        # BY INDEX TOO, because a name is not always typeable: a profile called
        # `\033` exists on a real machine and cannot be entered at a prompt.
        match = [accts[int(want)]]
    if not match:
        die(f"claude-mate: no account named {want!r} (see `claude-mate accounts`)")
    a = match[0]
    name = a["name"]
    if not a["removable"]:
        die("claude-mate: 'default' is your ~/.claude login, not a profile — "
            "this command will not delete it")
    email = read_email(name, a["dir"])
    print(f"\n{B}This deletes an account profile and everything in it.{OFF}")
    print(f"  name   {show_name(name)}")
    print(f"  email  {email or '(not logged in)'}")
    print(f"  dir    {a['dir']}")
    print(f"\n{D}That includes its login and every transcript under it. There is"
          f" no undo.{OFF}")
    # TYPE THE NAME. A y/n on a destructive action is a reflex; typing the name
    # is a decision, and it also proves you are deleting the one you think.
    token = name if show_name(name) == name else "delete"
    try:
        typed = input(f"\ntype {B}{token}{OFF} to confirm: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    if typed != token:
        print("not deleted.")
        return 1
    if email:
        # Say it once more, because "not logged in" is the case where this is
        # cheap and "logged in" is the case where it is not.
        print(f"{D}note: {email} will have to log in again if you recreate "
              f"this profile.{OFF}")
    try:
        shutil.rmtree(a["dir"])
    except OSError as e:
        die(f"claude-mate: could not delete {a['dir']}: {e}")
    print(f"deleted {name}.")
    talk("accounts-refresh")      # so the device's picker stops offering it
    return 0


def read_email(name, cfg_dir):
    """The login an account profile holds, from its own config.

    THE DEFAULT PROFILE'S STATE FILE IS ~/.claude.json, NOT ~/.claude/.claude.json
    -- claude writes it beside the directory, and only writes it INSIDE when
    CLAUDE_CONFIG_DIR is set. Reading the same path for both reported your main
    account as "(not logged in)" while the picker two lines away had its email.
    Same rule as account_email() in the wrapper.

    Read here rather than asked of the daemon: it is one small JSON file, and
    keeping it out of the daemon means the daemon never grows a reason to open
    files it does not otherwise need.
    """
    path = (os.path.expanduser("~/.claude.json") if name == "default"
            else os.path.join(cfg_dir, ".claude.json"))
    try:
        with open(path) as fh:
            return (json.load(fh).get("oauthAccount") or {}).get("emailAddress")
    except (OSError, ValueError):
        return None


def show_name(name):
    """A profile name you can actually see.

    Profile names come from whatever was typed at the picker, and an arrow key
    types an ESCAPE SEQUENCE -- so a real accounts dir can contain a directory
    called `\033`, which prints as nothing at all and leaves a row that looks
    like a blank line with an email next to it. Anything not plainly printable
    is shown as a repr so it is at least identifiable.
    """
    if name and all(32 <= ord(c) < 127 for c in name):
        return name
    return repr(name)


# ---------------------------------------------------------------------------
# The daemon, as something you can start rather than be told about
# ---------------------------------------------------------------------------
# THROUGH LAUNCHD, ALWAYS, and never by spawning the daemon directly. There is
# no pidfile, no flock and no single-instance guard anywhere in the daemon --
# and SocketServer.run() UNLINKS the socket path before binding it. So a second
# instance does not fail, it silently steals the socket from the first, while
# the first keeps the serial port: the CLI then talks to a daemon with no
# device, and the device is driven by a daemon nothing can reach. That is a
# genuinely horrible afternoon, and one `launchctl` call away from impossible.

def daemon_alive():
    """Is a daemon answering? `queue` is the only liveness proof there is.

    The socket has no ping, status or version verb -- six verbs, and anything
    unrecognised is parsed as a session update and dropped -- so the honest test
    is to ask it something real and see whether JSON comes back.
    """
    reply = talk("queue", timeout=2.0)
    if reply is None:
        return False
    try:
        json.loads(reply)
        return True
    except ValueError:
        return False


def launchd_loaded():
    """Is the LaunchAgent bootstrapped? `launchctl list` exits 113 if not."""
    try:
        return subprocess.call(["launchctl", "list", LAUNCHD_LABEL],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0
    except OSError:
        return False


def start_daemon():
    """Start (or restart) the daemon through its LaunchAgent. Returns a note.

    THE ORDER MATTERS AND THE OLD ADVICE WAS WRONG. Every error path in this
    project used to print `launchctl bootstrap gui/$UID ...`, which fails with
    "Bootstrap failed: 5: Input/output error" whenever the job is ALREADY
    loaded -- which is the common case, because the installer loads it. So the
    one instruction we gave people worked only on the machine where it was
    least needed. packaging/scripts/postinstall already had the modern
    sequence; this is that sequence, and the other call sites now point here.
    """
    if not os.path.exists(LAUNCHD_PLIST):
        return (f"no LaunchAgent at {LAUNCHD_PLIST}\n"
                f"  run the installer first:  ./install/install.sh")
    dom = f"gui/{os.getuid()}"
    run = lambda *a: subprocess.call(list(a), stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
    if not launchd_loaded():
        run("launchctl", "bootstrap", dom, LAUNCHD_PLIST)
    run("launchctl", "enable", f"{dom}/{LAUNCHD_LABEL}")
    # -k so an already-running job is restarted rather than left as it was;
    # this is also the "it is wedged, kick it" path.
    run("launchctl", "kickstart", "-k", f"{dom}/{LAUNCHD_LABEL}")
    # The daemon opens its socket a moment after launchd forks it. Wait, rather
    # than reporting a failure that is really just impatience.
    for _ in range(40):
        if daemon_alive():
            return None
        time.sleep(0.1)
    return ("started it, but nothing is answering on the socket yet.\n"
            f"  check the log:  tail -f ~/Library/Logs/claude-mate.err.log")


# ---------------------------------------------------------------------------
# Terminal plumbing
# ---------------------------------------------------------------------------
# ALL OF IT MOVED TO claude_mate_ui, and that is the point of this change rather
# than a tidy-up. The top level had arrow keys and every level underneath it
# still asked you to read a number off a list and type it; the only way to fix
# that once is for the submenus, `accounts rm` and the wrapper's own account
# picker to call the SAME chooser. See the note at the top of that module -- it
# is also a bug fix, because a prompt you type names into is how a profile
# called "\033" came to exist.
# THE MACHINERY ONLY, AND NOT THE COLOURS. Importing B/D/OFF from here would
# re-bind the names this file blanked for a non-TTY forty lines above, and put
# escape codes back into every pipe -- which is exactly what it did until the
# test caught it. The module keeps its own copies for its own rendering.
from claude_mate_ui import (                                    # noqa: E402
    Item, Term, confirm, pick, printable, read_key, supports_ui,
)

# ---------------------------------------------------------------------------
# Starting a session
# ---------------------------------------------------------------------------
# WHAT THE MENU ITEM ACTUALLY DOES: exactly what the maintainer types today,
# `claude --dangerously-skip-permissions`, but through the wrapper so the
# session is reported to the daemon and shows up on the device. Bare `claude`
# would run untracked and the whole point of the project would miss it.
#
# It EXECs rather than forking. The wrapper takes raw mode on this terminal's
# stdin itself and needs both fds to be real TTYs or it silently degrades to
# unwrapped claude; handing it the process rather than sitting above it as a
# parent avoids two programs negotiating over one terminal. The precedent is
# claude-mate-switch, which re-execs the wrapper the same way when it moves a
# conversation to another account.
#
# TWO ITEMS, NOT A HIDDEN DEFAULT. Skipping permission prompts is a real
# decision and this is somebody else's machine as often as it is ours, so the
# menu says which one it is doing rather than quietly picking. Anything else
# goes in CLAUDE_MATE_NEW_ARGS.
def exec_new_session(extra_argv, term=None):
    if term is not None:
        term.restore()
    if not os.path.exists(WRAP):
        die(f"claude-mate: cannot find the wrapper at {WRAP}")
    argv = [sys.executable, WRAP] + list(extra_argv)
    print(f"{D}starting: claude {' '.join(extra_argv)}{OFF}\n")
    sys.stdout.flush()
    try:
        os.execve(sys.executable, argv, dict(os.environ))
    except OSError as exc:
        die(f"claude-mate: could not start the wrapper: {exc}")


def extra_new_args():
    raw = os.environ.get("CLAUDE_MATE_NEW_ARGS", "").strip()
    return raw.split() if raw else []


# ---------------------------------------------------------------------------
# The app
# ---------------------------------------------------------------------------
REFRESH_S = 1.0


def _rows(snap):
    """The screen as a flat list of selectable rows, sessions first."""
    rows = [{"kind": "session", "s": s} for s in (snap or {}).get("queue", [])]
    rows.append({"kind": "new", "label": "Start new session",
                 "argv": extra_new_args()})
    rows.append({"kind": "new", "label": "Start new session · skip permissions",
                 "argv": ["--dangerously-skip-permissions"] + extra_new_args()})
    rows.append({"kind": "device", "label": "Device · link status and pairing"})
    rows.append({"kind": "accounts", "label": "Accounts · switch or review"})
    rows.append({"kind": "quit", "label": "Quit"})
    return rows


def _draw(term, snap, sel, rows, note, alive):
    cols = term.size()[0]
    dot = f"{COLOUR['done']}●{OFF}" if alive else f"{COLOUR['error']}●{OFF}"
    state = "running" if alive else "not running"
    out = [
        f" {B}claude-mate{OFF}   {D}{dot} daemon {state}"
        f" · {time.strftime('%H:%M:%S')}{OFF}",
        "",
    ]
    sessions = [r for r in rows if r["kind"] == "session"]
    if sessions:
        width = max(len(r["s"]["name"]) for r in sessions)
        out.append(f" {D}SESSIONS{OFF}")
    elif alive:
        out.append(f" {D}no sessions yet — start one below{OFF}")
    else:
        out.append(f" {D}the daemon is not running, so there is nothing to"
                   f" show yet{OFF}")
    for i, r in enumerate(rows):
        here = f"{B}▸{OFF}" if i == sel else " "
        if r["kind"] == "session":
            s = r["s"]
            col = COLOUR.get(s["state"], "")
            glass = f"{B}•{OFF}" if s.get("shown") else " "
            flag = "" if s.get("acked") else f"  {col}{B}needs you{OFF}"
            right = "  ".join(x for x in (s.get("model"), s.get("effort"),
                                          s.get("account"), s.get("limit")) if x)
            out.append(f" {here}{glass} {col}{s['name']:<{width}}  "
                       f"{s['state']:<7}{OFF} {mmss(s['secs']):>6}  "
                       f"{D}{right}{OFF}{flag}")
        else:
            if rows[i - 1]["kind"] == "session":
                out.append("")
            label = r["label"]
            body = f"{B}{label}{OFF}" if i == sel else label
            out.append(f" {here}  {body}")
    out.append("")
    if note:
        out.append(f" {note}")
        out.append("")
    if rows[sel]["kind"] == "session":
        out.append(f" {D}↑↓ move   ⏎ raise this session   a ack   f follow"
                   f"   m mirror   c continue{OFF}")
    else:
        out.append(f" {D}↑↓ move   ⏎ choose{OFF}")
    out.append(f" {D}r {'restart' if alive else 'start'} daemon   q quit{OFF}")
    return out


def cmd_app():
    """The arrow-key app. Only ever reached on a real terminal; see main()."""
    with Term() as term:
        sel, note, last_poll = 0, None, 0.0
        snap, alive = None, False
        while True:
            now = time.time()
            if now - last_poll >= REFRESH_S:
                last_poll = now
                alive = daemon_alive()
                snap = json.loads(talk("queue") or "null") if alive else None
            rows = _rows(snap)
            sel = max(0, min(sel, len(rows) - 1))
            term.paint(_draw(term, snap, sel, rows, note, alive))

            key = read_key(term.fd, timeout=0.25)
            if key is None:
                continue
            note = None
            row = rows[sel]
            if key in ("q", "ctrl-c", "eof"):
                return 0
            if key == "up":
                sel -= 1
                if sel < 0:
                    sel = len(rows) - 1
            elif key == "down":
                sel = (sel + 1) % len(rows)
            elif key == "home":
                sel = 0
            elif key == "end":
                sel = len(rows) - 1          # same keys as pick(), everywhere
            elif key == "r":
                note = f"{D}starting the daemon...{OFF}"
                term.paint(_draw(term, snap, sel, rows, note, alive))
                problem = start_daemon()
                note = (f"{COLOUR['error']}{problem}{OFF}" if problem
                        else f"{COLOUR['done']}daemon started{OFF}")
                last_poll = 0.0
            elif key == "enter":
                if row["kind"] == "quit":
                    return 0
                if row["kind"] == "new":
                    exec_new_session(row["argv"], term)     # never returns
                if row["kind"] == "device":
                    note = menu_device(term)
                    last_poll = 0.0
                elif row["kind"] == "accounts":
                    note = menu_accounts(term)
                    last_poll = 0.0
                elif row["kind"] == "session":
                    talk(f"select|{row['s']['name']}")
                    talk("press|G")
                    note = f"{D}raised {row['s']['name']}{OFF}"
                    last_poll = 0.0
            elif row["kind"] == "session" and key in APP_KEYS:
                talk(f"select|{row['s']['name']}")
                talk(f"press|{PRESSES[APP_KEYS[key]]}")
                note = f"{D}sent {key} to {row['s']['name']}{OFF}"
                last_poll = 0.0


# ---------------------------------------------------------------------------
# The levels underneath the top one
# ---------------------------------------------------------------------------
# THESE USED TO BE SHELL-OUTS AND THAT WAS THE COMPLAINT. "Accounts" ran
# `claude-mate-switch --help` and left you looking at an argparse usage block
# under a "press enter to go back"; "Device" dumped a four-screen report the
# same way. Both are arrow-driven menus now, built from the same pick() as the
# top level, so there is one set of keys in this program and esc always means
# back.

def _accounts_snapshot():
    reply = talk("accounts")
    if not reply:
        return None
    try:
        return json.loads(reply)
    except ValueError:
        return None


def menu_accounts(term):
    """The saved logins, and what you can do to one. Returns a note, or None."""
    while True:
        snap = _accounts_snapshot()
        if snap is None:
            return f"{COLOUR['error']}no daemon — cannot read the accounts{OFF}"
        accts = snap["accounts"]
        items = []
        for a in accts:
            email = read_email(a["name"], a["dir"]) or "(not logged in)"
            marks = [] if a["exists"] else ["missing"]
            # SAY WHEN A NAME IS UNTYPEABLE. This is where the "\033" profile
            # shows up, and the whole reason the old list was unusable: it
            # printed as a blank row, so the one account you wanted to delete
            # was the one you could not name.
            if show_name(a["name"]) != a["name"]:
                marks.append("unprintable name")
            items.append(Item(show_name(a["name"]) or "(blank)",
                              value=("acct", a),
                              detail="  ".join([email] + marks)))
        items.append(Item("Back", value=("back", None), gap=True))
        got = pick("ACCOUNTS", items, term=term,
                   hint="↑↓ move   ⏎ open   esc back",
                   note=f"{D}{printable(snap['accounts_dir'])}{OFF}")
        if got is None or got[0] == "back":
            return None
        note = menu_one_account(term, got[1])
        if note:
            return note


def menu_one_account(term, a):
    """What you can do to one login."""
    name = show_name(a["name"])
    email = read_email(a["name"], a["dir"]) or "(not logged in)"
    items = [Item("Use for the next new session", value="use",
                  detail="sets CLAUDE_MATE_ACCOUNT for a session started here")]
    if a["removable"]:
        items.append(Item("Delete this profile", value="rm", danger=True,
                          detail="its login and every transcript under it",
                          gap=True))
    items.append(Item("Back", value="back", gap=True))
    got = pick(f"ACCOUNT · {name}", items, term=term,
               note=f"{D}{printable(email)}\n {printable(a['dir'])}{OFF}".replace("\n", "\n "))
    if got == "use":
        os.environ["CLAUDE_MATE_ACCOUNT"] = a["name"]
        return (f"{COLOUR['done']}next new session will run as "
                f"{name}{OFF}")
    if got == "rm":
        return _delete_account(term, a)
    return None


def _delete_account(term, a):
    """Delete, behind a chooser rather than a typed name.

    The typed confirmation is right at a shell prompt -- typing the name proves
    you mean THAT one -- and wrong here, because the account most likely to need
    deleting is the one whose name cannot be typed. The chooser already proves
    which row you are on, so the second gate is the gesture, not the spelling:
    No is where the cursor starts.
    """
    name = show_name(a["name"])
    email = read_email(a["name"], a["dir"])
    ok = confirm(
        f"DELETE {name}?",
        f"{printable(email) or '(not logged in)'} · {printable(a['dir'])} · there is no undo")
    if not ok:
        return None
    try:
        shutil.rmtree(a["dir"])
    except OSError as e:
        return f"{COLOUR['error']}could not delete: {e}{OFF}"
    talk("accounts-refresh")
    return f"{COLOUR['done']}deleted {name}{OFF}"


def menu_device(term):
    """Link state and the things you can do about it."""
    while True:
        items = [
            Item("Connection report", value="report",
                 detail="every link, and the shortest fix for whichever is down"),
            Item("Pair a device", value="pair",
                 detail="puts PAIR? on its screen; press GO within 45s"),
            Item("Show the shared token", value="token",
                 detail="for typing into a cordless board's setup portal"),
            Item("Restart the daemon", value="daemon", gap=True),
            Item("Back", value="back", gap=True),
        ]
        got = pick("DEVICE", items, term=term)
        if got is None or got == "back":
            return None
        if got == "daemon":
            problem = start_daemon()
            return (f"{COLOUR['error']}{problem}{OFF}" if problem
                    else f"{COLOUR['done']}daemon restarted{OFF}")
        if got == "pair":
            reply = talk("pair")
            if reply is None:
                return f"{COLOUR['error']}no daemon{OFF}"
            if reply.startswith("error:"):
                return f"{COLOUR['error']}{reply.strip()[7:]}{OFF}"
            return (f"{COLOUR['done']}pairing armed — press GO on the device"
                    f"{OFF}")
        # The two that are genuinely a page of text rather than a choice.
        _foreground(term, [sys.executable,
                           os.path.join(HERE, "claude-mate-connect")]
                    + ([] if got == "report" else ["--token"]))


def _foreground(term, argv):
    """Hand the terminal to another tool, then take it back.

    Only for output that is a PAGE rather than a choice -- the connection
    report, the token. Anything that asks a question belongs in pick(), where
    the keys are the same as everywhere else.
    """
    term.restore()
    try:
        subprocess.call(argv)
        input("\n  press enter to go back ")
    except (OSError, EOFError, KeyboardInterrupt):
        pass
    term.__enter__()


def main(argv):
    if not argv or argv[0] in ("status", "queue", "ls", "list"):
        # THE APP ONLY ON A REAL TERMINAL, and it needs BOTH ends of it. stdout
        # alone is not enough -- the test suite runs the CLI from a developer's
        # terminal and would inherit a TTY stdin -- and stdin alone is not
        # enough either, because CI redirects `< /dev/null`. Piped, cron'd,
        # hooked or tested, this stays the one-shot queue print it always was.
        if not argv and sys.stdin.isatty() and sys.stdout.isatty():
            try:
                return cmd_app()
            except KeyboardInterrupt:
                return 0
        return cmd_status()
    cmd, rest = argv[0], argv[1:]
    if cmd in ("watch", "-w", "--watch"):
        try:
            return cmd_status(watch=True)
        except KeyboardInterrupt:
            print()
            return 0
    if cmd in PRESSES:
        return cmd_press(cmd)
    if cmd == "select":
        if not rest:
            die("claude-mate select: which session? (index or name)")
        return cmd_select(rest[0])
    if cmd in ("accounts", "account"):
        return cmd_accounts(rest)
    if cmd in ("app", "ui", "menu"):
        # The app by name, for when stdin is not a terminal but you want it
        # anyway -- and so the thing has a name to put in the documentation.
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            die("claude-mate app: needs a terminal on both stdin and stdout")
        try:
            return cmd_app()
        except KeyboardInterrupt:
            return 0
    if cmd == "daemon":
        if rest and rest[0] not in ("start", "restart"):
            die(f"claude-mate daemon: unknown subcommand {rest[0]!r}")
        problem = start_daemon()
        if problem:
            die(f"claude-mate: {problem}")
        print("daemon running.")
        return 0
    if cmd in ("-V", "--version", "version"):
        print(f"claude-mate {read_version()}")
        return 0
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    die(f"claude-mate: unknown command {cmd!r}. Try --help.")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
