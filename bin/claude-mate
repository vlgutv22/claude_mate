#!/usr/bin/env python3
"""claude-mate -- do what the device does, from a terminal.

WHY THIS EXISTS. The device is the good interface: one screen, four buttons, and
it is looking at you. But it is one device, it is sometimes across the room, and
sometimes it is flat. Everything it can do is a line on the daemon's socket, so
none of that needed to be exclusive to the hardware -- it just never had a way
in from a terminal.

IT PRESSES THE SAME BUTTONS. `claude-mate go` sends `press|G`, which the daemon
hands to the SAME ButtonReader that handles `B|G` off the wire. So GO means
exactly one thing on this project: the mirror closes first, a double press
inside the window toggles FOLLOW, the raised window is the one whose name was on
the glass. There is no second implementation to drift.

  claude-mate                 the app: arrow keys, on a terminal
  claude-mate status          the queue, printed once (what a pipe gets)
  claude-mate watch           ...and keep printing it
  claude-mate next|prev       step the selection (or scroll the mirror)
  claude-mate go              ack + raise that session's terminal
  claude-mate ack             ack only, leave the window alone
  claude-mate follow          toggle FOLLOW (PREV/NEXT also raise)
  claude-mate mirror          toggle the terminal mirror
  claude-mate continue        type "continue" into that session
  claude-mate new-terminal    open a terminal in that session's directory
  claude-mate select <n|name> point at a row instead of stepping to it
  claude-mate accounts        the saved logins
  claude-mate accounts rm <name|n> delete one, after saying its name back
  claude-mate history         the chats it has kept, newest first
  claude-mate history resume <n|id> [--skip-permissions|--ask-permissions]
                              pick one up again, where and as it was
  claude-mate history rm <n|id>    forget one, after typing its id back
  claude-mate history clear   forget every chat that is not open
  claude-mate link <auto|cable|ble|wifi|p2p>  the device's connection mode
  claude-mate trust           allow the TCP listener on the network you are on
  claude-mate trust --list    which networks it will listen on
  claude-mate daemon          start (or restart) the daemon via launchd
  claude-mate --version       what this is

RUN IT WITH NO ARGUMENTS ON A TERMINAL and you get the app: the queue with the
arrow keys live in it, and a menu that starts a new session -- the wrapper with
`--dangerously-skip-permissions`, which is the thing you would otherwise type --
without leaving for a shell. Redirect it anywhere (a pipe, a hook, cron, a test)
and it is the same one-shot queue print it has always been, because a program
that changes shape depending on who is watching has to be obvious about which
shape is which.

WHAT IT DELIBERATELY DOES NOT DO OVER THE SOCKET. The socket is chmod 0600 --
owner-only, which is all a hook needs, since hooks run in your own shells. Even
so, deletion is not a daemon command: a hook firing a malformed line should not
be able to remove a login. `accounts rm` therefore does the deletion HERE, in
this process, and only asks the daemon to re-read afterwards. `history rm` and
`history clear` are the same: the chats the daemon keeps are forgotten here,
and nothing on the socket can ask for that.
"""
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time

SOCK = os.environ.get("CLAUDE_MATE_SOCK", "/tmp/claude-mate.sock")

# Resolved through the SYMLINK, not around it. install.sh links this file into
# /usr/local/bin, so abspath() would put the sibling lookup in /usr/local/bin --
# where claude-mate-wrap is deliberately not linked (it is reached by shell
# alias, not by PATH). realpath() lands back in the repo, where the wrapper
# actually lives. claude-mate-switch had this exact bug and was broken for every
# installed user; it is fixed there too.
HERE = os.path.dirname(os.path.realpath(__file__))
WRAP = os.path.join(HERE, "claude-mate-wrap")
# The shared chooser lives beside this file. Through realpath for the same
# reason HERE is: this script is symlinked onto PATH, and the module is not.
if HERE not in sys.path:
    sys.path.insert(0, HERE)

# The LaunchAgent the installer sets up. Starting the daemon goes through
# launchd and never spawns python directly -- see start_daemon().
LAUNCHD_LABEL = "com.claudemate.daemon"
LAUNCHD_PLIST = os.path.expanduser(
    f"~/Library/LaunchAgents/{LAUNCHD_LABEL}.plist")
# Where launchd sends the daemon's stderr (StandardErrorPath in the plist). We
# read it when a start fails -- see why_the_daemon_died().
LAUNCHD_ERR_LOG = os.path.expanduser("~/Library/Logs/claude-mate.err.log")

VERSION_FILE = os.path.join(os.path.dirname(HERE), "packaging", "VERSION")

B, D, OFF = "\033[1m", "\033[2m", "\033[0m"
COLOUR = {
    "error":   "\033[31m",
    "waiting": "\033[33m",
    "working": "\033[36m",
    "done":    "\033[32m",
    "idle":    "\033[2m",
}
if not sys.stdout.isatty():
    B = D = OFF = ""
    COLOUR = {k: "" for k in COLOUR}

# The device's own vocabulary, so the mapping is visible in one place rather than
# spread through the argument parser. See ButtonReader._dispatch.
PRESSES = {
    "prev": "P", "next": "N", "go": "G", "ack": "K", "follow": "F",
    "mirror": "M", "continue": "C", "new-terminal": "T",
}

# The app's single-key shortcuts, named as CLI VERBS rather than button codes so
# PRESSES above stays the only place a code is written down. (It is also the
# only place tools/test_cli.py looks: it scrapes that dict and insists every
# verb it finds is documented, and a second dict of codes here would have made
# it demand documentation for a keystroke.)
APP_KEYS = {"a": "ack", "f": "follow", "m": "mirror", "c": "continue"}


def talk(line, timeout=6.0):
    """One command, one reply. None means the daemon could not be reached."""
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(timeout)
        c.connect(SOCK)
        c.sendall((line + "\n").encode())
        c.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = c.recv(65536)
            if not chunk:
                break
            buf += chunk
        c.close()
        return buf.decode("utf-8", errors="replace")
    except OSError:
        return None


def die(msg, code=1):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def need(line):
    reply = talk(line)
    if reply is None:
        # NAME A COMMAND THAT WORKS. This used to say `launchctl bootstrap`,
        # which fails with "Bootstrap failed: 5: Input/output error" whenever
        # the job is already loaded -- i.e. on every machine that ran the
        # installer, which is every machine that has this file. See start_daemon().
        die(f"claude-mate: no daemon on {SOCK}\n"
            f"  start it:  claude-mate daemon")
    if reply.startswith("error:"):
        die(f"claude-mate: {reply.strip()[7:]}")
    return reply


def mmss(secs):
    return f"{int(secs) // 60}:{int(secs) % 60:02d}"


def read_version():
    """The packaged version, or a plain marker when running from a checkout."""
    try:
        with open(VERSION_FILE) as fh:
            return fh.read().strip() or "(unknown)"
    except OSError:
        return "(from a source checkout)"


# A WORKFLOW READS HERE AS IT READS ON THE GLASS. These two are the daemon's
# _wf_clock and _wf_tokens, line for line -- copied, not imported, because the
# CLI must run where the daemon's own imports (pyserial) do not -- and
# tools/test_cli.py holds the copies to the originals over every boundary.
def wf_clock(secs):
    """A run's clock in Claude's own units: 45s, 2m39s, 1h02m, 1d03h. Not
    mmss(): that is r1's time in STATE, and a ten-hour run printed '622:55'
    reads like a lot of minutes where the band beside it says 10h22m."""
    s = int(max(0, secs))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}m"
    return f"{s // 86400}d{s % 86400 // 3600:02d}h"


def wf_tokens(n):
    """Compact tokens, as the band prints them: 999, 1.2k, 543k, 1.4M, 12M,
    1.2B. Rounded half up in integers, and a value that rounds past its unit
    moves up one -- 999_950 is '1.0M', never '1000k'."""
    n = max(0, int(n))
    if n < 1000:
        return str(n)
    for div, unit in ((10 ** 3, "k"), (10 ** 6, "M"), (10 ** 9, "B")):
        tenths = (10 * n + div // 2) // div       # n / div to one decimal
        if tenths < 100:
            return f"{tenths // 10}.{tenths % 10}{unit}"
        whole = (n + div // 2) // div
        if whole < 1000 or unit == "B":
            return f"{whole}{unit}"
    return str(n)                                 # unreachable


# A workflow's status word, coloured like the session state it reads as.
WF_COLOUR = {"running": "working", "paused": "waiting", "done": "done",
             "ended": "error"}


def _wf_text(text):
    """Text from a workflow, safe to print. Through printable() because a
    workflow is named by whoever wrote it -- and never with a '▸' in it, which
    the app uses to mark the selected row and which its tests find it by."""
    return printable(str(text or "")).replace("▸", ">")


def wf_name(w):
    return _wf_text(w.get("name"))


def wf_parts(w, more=0):
    """A workflow after its name, as (kind, text) in the order it prints:
    'running  3/5  2m39s  543k tokens', and '+N more' last.

    The same facts the device's band shows, in its units -- the run's clock
    in Claude's, tokens compact -- and plain text on a pipe: every colour is
    one of the TTY-gated constants above. Kinds, so a line that does not fit
    can give up the parts that matter least first (see _wf_line)."""
    word = _wf_text(w.get("status")) or "running"
    col = COLOUR.get(WF_COLOUR.get(word, ""), "")
    parts = [("word", f"{col}{word}{OFF}")]
    failed = w.get("failed")
    if w.get("st") == "E" and not failed:
        # E is "running, but an agent failed"; the count itself is not
        # something the screen shows, so say it without one.
        parts.append(("failing", f"{COLOUR['error']}an agent failed{OFF}"))
    done, total, pct = w.get("done"), w.get("total"), w.get("pct")
    if done is not None and total is not None:
        parts.append(("count", f"{done}/{total}"))
    elif pct is not None:
        parts.append(("count", f"{pct}%"))
    if failed:
        parts.append(("failed", f"{COLOUR['error']}{failed} failed{OFF}"))
    if w.get("secs") is not None:
        parts.append(("clock", wf_clock(w["secs"])))
    if w.get("tokens") is not None:
        parts.append(("tokens", f"{wf_tokens(w['tokens'])} tokens"))
    if w.get("note"):
        parts.append(("note", _wf_text(w["note"])))
    if more:
        parts.append(("more", f"{D}+{more} more{OFF}"))
    return parts


def wf_summary(w, more=0):
    """wf_parts() as one string: what `status` prints after the name."""
    return "  ".join(text for _kind, text in wf_parts(w, more))


# ---- fitting a line to the app's width ------------------------------------ #
# A line wider than the terminal wraps and scrolls the whole frame, so the lines
# that carry data are fitted in COLUMNS by vis_width() and clip(). They moved to
# claude_mate_ui, beside the chooser that now fits its own lines with them, and
# are imported below with the rest of its machinery -- see the note there.
WF_NAME_MIN = 12          # columns a name is cut to before anything else goes


def _wf_line(w, more, room):
    """The app's line under a session -- '    ↳ name  running  3/5  2m39s
    543k tokens  +1 more' -- in at most `room` columns.

    What gives, in order: the name, down to WF_NAME_MIN columns (Claude's own
    footer already cuts names at 28, and a cut name still tells two runs
    apart); then the parts at the end -- the tokens, '+N more', the clock, the
    note -- with any room a dropped part frees going back to the name; last a
    plain cut. The status word, a failing agent and the counts are what the
    line is for, and stay longest."""
    lead = f"    {D}↳{OFF} "
    full, parts = wf_name(w), wf_parts(w, more)
    name = full

    def line():
        return f"{lead}{name}  " + "  ".join(t for _k, t in parts)

    over = vis_width(line()) - room
    if over > 0:
        name = clip(full, max(WF_NAME_MIN, vis_width(full) - over))
    for kind in ("tokens", "more", "clock", "note"):
        if vis_width(line()) <= room:
            break
        parts = [p for p in parts if p[0] != kind]
    spare = room - vis_width(line())
    if spare > 0 and name != full:
        name = clip(full, vis_width(name) + spare)  # what a dropped part freed
    return clip(line(), room)


def session_workflows(s):
    """The workflows a queue entry lists, or [] -- an older daemon sends none,
    and a CLI newer than its daemon must still print the queue."""
    wfs = s.get("workflows") or []
    return [w for w in wfs if isinstance(w, dict)] if isinstance(wfs, list) else []


def render(snap):
    """The queue, laid out like the glass: the shown row marked, alerts loud,
    and under each session the dynamic workflows it is running."""
    q = snap.get("queue", [])
    if not q:
        print(f"{D}no sessions. start one with `claude` in a project.{OFF}")
        return
    width = max(len(s["name"]) for s in q)
    for s in q:
        col = COLOUR.get(s["state"], "")
        # The two things the device says with a box and a flash: which row is on
        # the glass, and which rows are shouting.
        here = f"{B}>{OFF}" if s["shown"] else " "
        flag = "" if s["acked"] else f" {col}{B}<-- needs you{OFF}"
        right = "  ".join(x for x in (s["model"], s["effort"],
                                      s["account"], s["limit"]) if x)
        print(f" {here} {s['i']}  {col}{s['name']:<{width}}  "
              f"{s['state']:<7}{OFF} {mmss(s['secs']):>6}  {D}{right}{OFF}{flag}")
        # EVERY visible workflow, one indented line each -- a terminal has the
        # room the glass does not, so it lists what the band sums up as "+N".
        for w in session_workflows(s):
            print(f"        {D}workflow{OFF} {wf_name(w)}  {wf_summary(w)}")
    if snap.get("follow"):
        print(f"\n {D}FOLLOW is on: prev/next also raise the terminal{OFF}")


def cmd_status(watch=False):
    while True:
        snap = json.loads(need("queue"))
        if watch and sys.stdout.isatty():
            # Full clear, not a scroll: this is a dashboard, and a screen that
            # accumulates history is one you have to read the bottom of.
            #
            # GUARDED, because this was the one place the "a pipe gets plain
            # text" contract leaked: the colours two dozen lines up are blanked
            # for a non-TTY and this escape was not, so `claude-mate watch | tee`
            # wrote a clear-screen into the file once a second.
            sys.stdout.write("\033[2J\033[H")
            print(f"{B}claude-mate{OFF}  {D}{time.strftime('%H:%M:%S')} "
                  f"· ctrl-c to stop{OFF}\n")
        render(snap)
        if not watch:
            return 0
        time.sleep(1.0)


def cmd_press(name):
    need(f"press|{PRESSES[name]}")
    # Show the result rather than announcing the action: what matters after a
    # `next` is which session is now under the cursor. ("select" used to be in
    # this tuple and could never match -- it is routed to cmd_select and is not
    # a key in PRESSES, so cmd_press never sees it.)
    if name in ("prev", "next", "follow"):
        render(json.loads(need("queue")))
    return 0


LINKS = {
    "auto":  "the cable when a Mac is on the other end of it, otherwise the "
             "radio you last chose. Decided at boot",
    "cable": "USB only, both radios off -- the quiet mode for a docked device",
    "ble":   "Bluetooth LE, no network at all",
    "wifi":  "joins the network you configured, and reaches the daemon over it",
    "p2p":   "the DEVICE becomes the access point and your Mac joins it -- no "
             "router, no credentials, nothing else on the segment",
}


def cmd_link(rest):
    """Move the cabled device onto another transport.

    The device has always been able to do this -- `I|WIFI` on its USB console --
    and there has never been a way to say it from here. The console is a port
    this daemon holds open, so the honest instruction used to be "stop the
    daemon, run miniterm, type a line, start the daemon again", and the halfway
    version of it (leave the daemon up) silently split the device's replies
    between two readers.
    """
    if not rest or rest[0] in ("-h", "--help"):
        print("usage: claude-mate link <auto|cable|ble|wifi|p2p>\n")
        for name, what in LINKS.items():
            print(f"  {B}{name:5}{OFF} {D}{what}{OFF}")
        print(f"\n  {D}The device reboots into the new transport (~3 s). It is "
              f"stored,\n  so it survives power cycles -- and a reflash.{OFF}")
        if "p2p" not in rest:
            print(f"\n  {D}p2p prints the network name and password to join; "
                  f"they are also\n  on the device's screen while it waits.{OFF}")
        return 0
    want = rest[0].strip().lower()
    if want not in LINKS:
        die(f"claude-mate link: unknown transport {rest[0]!r} "
            f"({', '.join(LINKS)})")
    reply = talk(f"link|{want}")
    if reply is None:
        die(f"claude-mate: no daemon on {SOCK}\n"
            f"  start it:  claude-mate daemon")
    if reply.startswith("error:"):
        # The common one is "no device on the cable", and it deserves better
        # than being echoed: the transport is set over USB and only over USB,
        # which is not obvious from a command that otherwise works over the air.
        detail = reply[6:].strip()
        die(f"claude-mate link: {detail}\n"
            f"  The transport is set over the USB cable. Plug the device in "
            f"and try again.")
    print(f"link: {want}. The device is rebooting into it.")
    if want == "p2p":
        print(f"  {D}Join the network shown on its screen from this Mac; it "
              f"dials the daemon itself.{OFF}")
    return 0


TRUSTED_FILE = os.path.expanduser(
    os.environ.get("CLAUDE_MATE_TRUSTED_FILE",
                   "~/.config/claude-mate/trusted-networks"))


def _network_now():
    """(gateway mac, gateway ip) for the network this Mac is on, or (None, ip).

    The same fingerprint the daemon uses -- see the note above TRUSTED_FILE in
    the daemon. Duplicated rather than imported because this file is a script on
    PATH and the daemon is not importable from it.
    """
    gw = ""
    try:
        out = subprocess.run(["route", "-n", "get", "default"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=3).stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return None, None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("gateway:"):
            gw = line.split(":", 1)[1].strip()
    if not gw:
        return None, None
    try:
        arp = subprocess.run(["arp", "-n", gw], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL,
                             timeout=3).stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return None, gw
    if " at " not in arp:
        return None, gw
    raw = arp.split(" at ", 1)[1].split()[0]
    parts = raw.strip().lower().split(":")
    if len(parts) != 6:
        return None, gw
    try:
        return ":".join(f"{int(p, 16):02x}" for p in parts), gw
    except ValueError:
        return None, gw


def _read_trusted():
    """[(mac, label)] in file order."""
    rows = []
    try:
        with open(TRUSTED_FILE, encoding="utf-8") as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if not line:
                    continue
                mac, _, label = line.partition(" ")
                rows.append((mac.strip().lower(), label.strip() or "(unnamed)"))
    except OSError:
        pass
    return rows


def _write_trusted(rows):
    os.makedirs(os.path.dirname(TRUSTED_FILE), exist_ok=True)
    fd = os.open(TRUSTED_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        for mac, label in rows:
            fh.write(f"{mac} {label}\n")


def cmd_trust(rest):
    """Which networks the daemon will open its TCP listener on.

    The daemon refuses to listen anywhere else, so this is the difference
    between a device that links at home and a port that offers itself to a cafe.
    """
    args = list(rest)
    if args and args[0] in ("-h", "--help"):
        print("usage: claude-mate trust [<label>]      trust the network you "
              "are on now\n"
              "       claude-mate trust --list         show trusted networks\n"
              "       claude-mate trust --remove <n|mac>\n")
        print(f"  {D}A network is identified by its gateway's MAC address: "
              f"macOS hides the\n  SSID from a background daemon, and every "
              f"other cafe is 192.168.1.0/24.{OFF}")
        return 0

    now, gw = _network_now()
    rows = _read_trusted()

    if args and args[0] in ("--list", "-l", "list"):
        if not rows:
            print(f"no trusted networks yet {D}(the daemon is not listening "
                  f"on any network){OFF}")
        for i, (mac, label) in enumerate(rows):
            here = f"  {COLOUR['done']}<- you are here{OFF}" if mac == now else ""
            print(f" {i}  {mac}  {B}{label}{OFF}{here}")
        if now and now not in [m for m, _ in rows]:
            print(f"\n {D}this network ({now}) is NOT trusted; "
                  f"`claude-mate trust` to add it{OFF}")
        return 0

    if args and args[0] in ("--remove", "--rm", "-r", "remove"):
        if len(args) < 2:
            die("claude-mate trust --remove: which one? (index or MAC)")
        want = args[1].strip().lower()
        keep, gone = [], None
        for i, (mac, label) in enumerate(rows):
            if str(i) == want or mac == want:
                gone = (mac, label)
            else:
                keep.append((mac, label))
        if not gone:
            die(f"claude-mate trust: no trusted network {args[1]!r}")
        _write_trusted(keep)
        print(f"removed {gone[0]} {gone[1]}")
        if gone[0] == now:
            print(f"  {D}that was the network you are on -- the daemon will "
                  f"close its listener within ~20s{OFF}")
        return 0

    # No flag: trust the network we are on.
    if not now:
        die("claude-mate trust: cannot identify this network"
            + (f" (gateway {gw} has no ARP entry yet -- try again in a moment)"
               if gw else " (no default route: are you online?)"))
    label = " ".join(args) if args else "trusted"
    for mac, existing in rows:
        if mac == now:
            print(f"already trusted: {now} {existing}")
            return 0
    rows.append((now, label))
    _write_trusted(rows)
    print(f"trusted {now} {B}{label}{OFF}")
    print(f"  {D}the daemon opens its listener on this network within ~20s{OFF}")
    return 0


def cmd_select(want):
    reply = need(f"select|{want}")
    print(f"{D}{reply.strip()[3:]}{OFF}" if reply.startswith("ok ") else reply.strip())
    render(json.loads(need("queue")))
    return 0


def cmd_accounts(argv):
    snap = json.loads(need("accounts"))
    accts = snap["accounts"]
    if not argv:
        for i, a in enumerate(accts):
            email = read_email(a["name"], a["dir"])
            mark = "" if a["exists"] else f"  {D}(missing){OFF}"
            print(f"  {i}  {show_name(a['name']):<14} "
                  f"{D}{email or '(not logged in)'}{OFF}{mark}")
        print(f"\n{D}dir: {snap['accounts_dir']}{OFF}")
        print(f"{D}limits + switching: claude-mate-switch{OFF}")
        return 0
    if argv[0] not in ("rm", "remove", "delete"):
        die(f"claude-mate accounts: unknown subcommand {argv[0]!r}")
    if len(argv) < 2:
        # ASK, RATHER THAN SCOLD. "which account?" is a fair error at the end
        # of a pipe and a silly one at a terminal, where we already know the
        # list and the answer is one arrow key away. It is also the only way to
        # reach a profile whose name cannot be typed -- see show_name().
        if not supports_ui():
            die("claude-mate accounts rm: which account? "
                "(see `claude-mate accounts`)")
        items = []
        for i, a in enumerate(accts):
            if not a["removable"]:
                continue
            email = read_email(a["name"], a["dir"]) or "(not logged in)"
            items.append(Item(show_name(a["name"]) or "(blank)",
                              value=a["name"], detail=email))
        if not items:
            die("claude-mate accounts rm: no removable profiles")
        items.append(Item("Cancel", value=None, gap=True))
        want = pick("DELETE WHICH ACCOUNT?", items,
                    hint="↑↓ move   ⏎ choose   esc cancel")
        if want is None:
            print("not deleted.")
            return 1
    else:
        want = argv[1]
    match = [a for a in accts if a["name"] == want]
    if not match and want.isdigit() and 0 <= int(want) < len(accts):
        # BY INDEX TOO, because a name is not always typeable: a profile called
        # `\033` exists on a real machine and cannot be entered at a prompt.
        match = [accts[int(want)]]
    if not match:
        die(f"claude-mate: no account named {want!r} (see `claude-mate accounts`)")
    a = match[0]
    name = a["name"]
    if not a["removable"]:
        die("claude-mate: 'default' is your ~/.claude login, not a profile — "
            "this command will not delete it")
    email = read_email(name, a["dir"])
    print(f"\n{B}This deletes an account profile and everything in it.{OFF}")
    print(f"  name   {show_name(name)}")
    print(f"  email  {email or '(not logged in)'}")
    print(f"  dir    {a['dir']}")
    print(f"\n{D}That includes its login and every transcript under it. There is"
          f" no undo.{OFF}")
    in_history = history_on_account(a["dir"])
    if in_history:
        print(f"{D}{history_account_note(in_history)}.{OFF}")
    # TYPE THE NAME. A y/n on a destructive action is a reflex; typing the name
    # is a decision, and it also proves you are deleting the one you think.
    token = name if show_name(name) == name else "delete"
    try:
        typed = input(f"\ntype {B}{token}{OFF} to confirm: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    if typed != token:
        print("not deleted.")
        return 1
    if email:
        # Say it once more, because "not logged in" is the case where this is
        # cheap and "logged in" is the case where it is not.
        print(f"{D}note: {email} will have to log in again if you recreate "
              f"this profile.{OFF}")
    try:
        shutil.rmtree(a["dir"])
    except OSError as e:
        die(f"claude-mate: could not delete {a['dir']}: {e}")
    print(f"deleted {name}.")
    talk("accounts-refresh")      # so the device's picker stops offering it
    return 0


def read_email(name, cfg_dir):
    """The login an account profile holds, from its own config.

    THE DEFAULT PROFILE'S STATE FILE IS ~/.claude.json, NOT ~/.claude/.claude.json
    -- claude writes it beside the directory, and only writes it INSIDE when
    CLAUDE_CONFIG_DIR is set. Reading the same path for both reported your main
    account as "(not logged in)" while the picker two lines away had its email.
    Same rule as account_email() in the wrapper.

    Read here rather than asked of the daemon: it is one small JSON file, and
    keeping it out of the daemon means the daemon never grows a reason to open
    files it does not otherwise need.
    """
    path = (os.path.expanduser("~/.claude.json") if name == "default"
            else os.path.join(cfg_dir, ".claude.json"))
    try:
        with open(path) as fh:
            return (json.load(fh).get("oauthAccount") or {}).get("emailAddress")
    except (OSError, ValueError):
        return None


def show_name(name):
    """A profile name you can actually see.

    Profile names come from whatever was typed at the picker, and an arrow key
    types an ESCAPE SEQUENCE -- so a real accounts dir can contain a directory
    called `\033`, which prints as nothing at all and leaves a row that looks
    like a blank line with an email next to it. Anything not plainly printable
    is shown as a repr so it is at least identifiable.
    """
    if name and all(32 <= ord(c) < 127 for c in name):
        return name
    return repr(name)


# ---------------------------------------------------------------------------
# History: the chats the daemon has kept
# ---------------------------------------------------------------------------
# ONE FILE PER CHAT, WRITTEN BY THE DAEMON, READ AND DELETED HERE. For every
# conversation a wrapped session has run a turn in, the daemon writes
# ~/.config/claude-mate/history/<id>.json and keeps a hard link to the
# transcript beside it (<id>.jsonl), so Claude Code's own cleanup -- or a
# deleted profile -- cannot take the conversation away while the record is
# there. None of it goes through the socket. Reading works with the daemon down,
# which is the crash this exists for; deleting happens in this process, for the
# reason `accounts rm` does above.
HISTORY_READ_MAX = 65536      # bytes of a record, or of a transcript's tail
CTX_STALE_S = 900.0           # the wrapper's: a context this stale is dead
LIVE_REPORT_S = 60.0          # a queue row this quiet is a dead terminal's: a
                              # wrapper reports at least every 20 s
TITLE_MAX = 200               # characters of a title; the screen cuts shorter
_UUID = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
# The transcript records a title is read from, newest first, and their keys.
_TITLE_KEYS = (("custom-title", "customTitle"),     # -n/--name, or /rename
               ("ai-title", "aiTitle"),
               ("last-prompt", "lastPrompt"))


def history_dir():
    """Where the records are. Worked out when asked, never at import, so a
    test that points HOME somewhere else gets somewhere else."""
    return os.path.expanduser("~/.config/claude-mate/history")


def _read_regular(path, limit=HISTORY_READ_MAX, tail=False, uid=None):
    """At most `limit` bytes of a REGULAR file -- its end, with `tail` -- or
    None. (bytes, offset read from.) Given `uid`, only a file that user owns.

    O_NOFOLLOW AND O_NONBLOCK, AND A TYPE CHECK. The history directory and the
    terminals' context directory are places other things can write into: a FIFO
    named like a record would hang open() forever, and a symlink to /dev/zero
    would be read until memory ran out."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except (OSError, ValueError):
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (uid is not None
                                             and st.st_uid != uid):
            return None
        start = max(0, st.st_size - limit) if tail else 0
        if start:
            os.lseek(fd, start, os.SEEK_SET)
        chunks, left = [], limit
        while left > 0:
            b = os.read(fd, left)
            if not b:
                break
            chunks.append(b)
            left -= len(b)
        return b"".join(chunks), start
    except OSError:
        return None
    finally:
        os.close(fd)


def _path_ok(p):
    """An absolute path with nothing in it a terminal or execve() would choke on
    -- the daemon's own rule for the paths it is sent, checked again here
    because a record is a file anyone with this login can edit."""
    return (isinstance(p, str) and p.startswith("/") and len(p) <= 4096
            and not any(ord(c) < 0x20 or ord(c) == 0x7F for c in p))


def _when(v):
    """A timestamp from a record, or None for anything that is not one."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    try:
        return float(v) if math.isfinite(v) else None
    except OverflowError:                 # an int past any float
        return None


def _record(path, conv):
    """One record, every field checked for its type, or None.

    A field of the wrong type counts as absent rather than sinking the record:
    the file name already says which chat it is, and a chat you cannot see is a
    chat you cannot delete. The id IS the file name -- the daemon writes
    <id>.json and nothing else, and forget_chats() unlinks by it."""
    got = _read_regular(path)
    if got is None:
        return None
    try:
        r = json.loads(got[0].decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    if not isinstance(r, dict):
        return None
    cfg = r.get("config_dir")
    if not (cfg is None or cfg == "" or _path_ok(cfg)):
        cfg = None
    flags = r.get("flags")
    if not (isinstance(flags, list) and len(flags) <= 64 and all(
            isinstance(f, str) and not any(ord(c) < 0x20 or ord(c) == 0x7F
                                           for c in f) for f in flags)):
        flags = None
    project = r.get("project")
    if not (isinstance(project, str) and project not in ("", ".", "..")
            and "/" not in project and _path_ok("/" + project)):
        project = ""                  # a directory NAME, never a path

    def text(key):
        return r[key] if isinstance(r.get(key), str) else ""

    return {
        "conversation": conv,
        "name": text("name"),
        "cwd": r["cwd"] if _path_ok(r.get("cwd")) else "",
        "config_dir": cfg,
        "account": text("account"),
        "flags": flags,
        "last_active": max(0.0, _when(r.get("last_active")) or 0.0),
        "ended": _when(r.get("ended")),
        "project": project,
    }


def load_history():
    """Every readable record, newest first (last_active, then id). Never
    raises: an unreadable or malformed file is skipped, and the directory not
    existing yet is simply no history."""
    root = history_dir()
    try:
        names = os.listdir(root)
    except (OSError, ValueError):
        return []
    out = []
    for fn in names:
        # <id>.json only: the daemon's .tmp and .lnk files are on their way to
        # becoming one, and <id>.jsonl is the kept transcript, not a record.
        if not fn.endswith(".json") or not _UUID.fullmatch(fn[:-5]):
            continue
        try:
            rec = _record(os.path.join(root, fn), fn[:-5])
        except Exception:                         # noqa: BLE001
            rec = None
        if rec:
            out.append(rec)
    out.sort(key=lambda r: (-r["last_active"], r["conversation"]))
    return out


def _queue_snapshot(timeout=2.0):
    """The daemon's queue as a dict, or None when nothing answers with one."""
    reply = talk("queue", timeout=timeout)
    if not reply:
        return None
    try:
        snap = json.loads(reply)
    except ValueError:
        return None
    return snap if isinstance(snap, dict) else None


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, OverflowError):     # no such pid, or none ever
        return False
    except OSError:
        return True               # EPERM: it exists, it is just not ours
    return True


def _quiet(s):
    """Seconds since the daemon last heard from a queue row's terminal; 0 from
    a daemon too old to send `seen`, which is taken at its word."""
    v = s.get("seen")
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else 0


def _heard(s):
    """Is a queue row's terminal still reporting (LIVE_REPORT_S)?"""
    return not _quiet(s) > LIVE_REPORT_S


def _ctx_conversations(ctx):
    """Every conversation a terminal's context file names: the one its
    wrapper is sure of, and the one its transcript scan found.

    THE SCAN COUNTS HERE, THOUGH IT IS NOT GOOD ENOUGH TO RECORD A CHAT BY.
    `conversation` is set only once the wrapper knows the id for certain, and
    a chat opened through claude's own picker, `-r <name>` or `--from-pr`
    never gets one -- it read as closed while it ran, and Resume started a
    second claude on it. Its terminal's file still carries the transcript the
    wrapper found (and so its session id), and for liveness a wrong guess only
    ever refuses a resume."""
    out = set()
    for key in ("conversation", "session_id"):
        v = ctx.get(key)
        if isinstance(v, str) and _UUID.fullmatch(v.lower()):
            out.add(v.lower())
    tr = ctx.get("transcript")
    if isinstance(tr, str) and tr.endswith(".jsonl"):
        name = os.path.basename(tr)[:-len(".jsonl")].lower()
        if _UUID.fullmatch(name):
            out.add(name)
    return out


def live_conversations(snap):
    """The conversations open in a terminal right now, as a set of ids.

    TWO SOURCES, AND THE SECOND IS THE ONE THAT MATTERS. The daemon's queue
    says which conversation each wrapped session is running -- when there is a
    daemon to ask. When it is down, or has just restarted and the wrappers have
    not re-registered yet (up to a keepalive, 20 s), the queue says nothing is
    open while chats are, and Resume would start a SECOND claude on one of them:
    two processes appending to one transcript fork it, and whichever branch a
    later resume follows, the other one's turns are gone from the context. So
    every wrapper's per-terminal context file counts too -- if its process is
    alive and it has been refreshed recently (the switch's CTX_STALE_S).

    AND A QUEUE ROW ONLY WHILE IT IS STILL BEING HEARD FROM. A terminal killed
    outright (kill -9, a crashed terminal app) sends no `end`, and its row stays
    in the queue until the daemon prunes it -- up to ten minutes in which the
    chat you most want back would be refused as "open". Its context file says
    otherwise at once (the pid is gone); its row says so once it has missed a
    few keepalives (`seen`, LIVE_REPORT_S). A daemon too old to send `seen` is
    taken at its word."""
    live = set()
    if isinstance(snap, dict) and isinstance(snap.get("queue"), list):
        for s in snap["queue"]:
            if not isinstance(s, dict) or not _heard(s):
                continue
            conv = s.get("conversation")
            if isinstance(conv, str) and conv:
                live.add(conv.lower())
    uid = os.getuid()
    d = os.path.join(tempfile.gettempdir(), f"claude-mate-ctx-{uid}")
    # A DIRECTORY ONLY THIS USER CAN WRITE, OR NONE AT ALL. Nothing in these
    # files is signed, so they are only as true as the directory is private:
    # where the temp dir is a shared /tmp, another user who made this one
    # first could plant files that hold any chat "open" -- refused by rm,
    # clear and resume. So a real directory (not a symlink), this user's,
    # writable by no one else -- and in it, only this user's files.
    try:
        st = os.lstat(d)
        if (not stat.S_ISDIR(st.st_mode) or st.st_uid != uid
                or st.st_mode & 0o022):
            return live
        names = os.listdir(d)
    except (OSError, ValueError):
        return live
    now = time.time()
    for fn in names:
        if not fn.endswith(".json"):
            continue
        got = _read_regular(os.path.join(d, fn), uid=uid)
        try:
            ctx = json.loads(got[0].decode("utf-8")) if got else None
            if not isinstance(ctx, dict):
                continue
            pid = ctx.get("pid")
            fresh = now - float(ctx.get("updated_at") or 0) < CTX_STALE_S
        except (UnicodeDecodeError, ValueError, TypeError, OverflowError):
            continue
        if fresh and isinstance(pid, int) and not isinstance(pid, bool) \
                and pid > 0 and _pid_alive(pid):
            live |= _ctx_conversations(ctx)
    return live


def chat_status(rec, live):
    """open (in a terminal now), closed (its wrapper said so) or interrupted
    (it never said: a crash, a killed terminal, a reboot)."""
    if rec["conversation"] in live:
        return "open"
    return "closed" if rec["ended"] is not None else "interrupted"


def _accounts_root():
    return os.path.expanduser(
        os.environ.get("CLAUDE_MATE_ACCOUNTS_DIR", "~/.claude-accounts"))


def _search_bases(rec):
    """The config dirs a chat's transcript can be under: the one it ran in when
    that is known ('' is the default login, ~/.claude), else every login."""
    cfg = rec["config_dir"]
    if cfg == "":
        return [os.path.expanduser("~/.claude")]
    if cfg:
        return [cfg]
    bases = [os.path.expanduser("~/.claude")]
    root = _accounts_root()
    try:
        bases += [os.path.join(root, d) for d in sorted(os.listdir(root))
                  if os.path.isdir(os.path.join(root, d))]
    except (OSError, ValueError):
        pass
    return bases


def _locate(rec):
    """(Claude's own copy of the transcript, the config dir it is under), or
    ("", ""). By listdir and never by glob: profile names are whatever someone
    typed, and `work [eu]` is a glob pattern that matches nothing."""
    name = rec["conversation"] + ".jsonl"
    try:
        for base in _search_bases(rec):
            root = os.path.join(base, "projects")
            try:
                dirs = os.listdir(root)
            except (OSError, ValueError):
                continue
            if rec["project"] in dirs:                # where it was last seen
                dirs.remove(rec["project"])
                dirs.insert(0, rec["project"])
            for d in dirs:
                p = os.path.join(root, d, name)
                if os.path.isfile(p):
                    return p, base
    except Exception:                                 # noqa: BLE001
        pass
    return "", ""


def chat_transcript(rec):
    """Claude Code's own copy of a chat's transcript, or ''. Never raises."""
    return _locate(rec)[0]


def chat_kept(rec):
    """The copy the daemon kept for this chat, or ''. A regular file only: the
    kept copy is a hard link, and anything else there was not put there by
    us."""
    p = os.path.join(history_dir(), rec["conversation"] + ".jsonl")
    try:
        return p if stat.S_ISREG(os.lstat(p).st_mode) else ""
    except (OSError, ValueError):
        return ""


def _clean(text):
    """Text from a record or a transcript, as one printable line -- and never
    with the '▸' the app marks its cursor with, which is how its tests (and a
    person) find the cursor. Same rule as _wf_text."""
    return printable(" ".join(str(text or "").split())).replace("▸", ">")


def chat_title(rec, path=None):
    """What a chat is about, in one line, or ''. Never raises.

    ONE READ, OF THE END. The records a title comes from are appended as the
    chat goes, so the newest are in the last 64 KB, where all three of these
    were for nearly every real transcript sampled: the name you gave it
    (custom-title, from -n or /rename), else the one Claude gave it (ai-title),
    else the last thing you asked (last-prompt, its first line). Claude's own
    copy if there is one, else the one kept here."""
    try:
        path = path or chat_transcript(rec) or chat_kept(rec)
        got = _read_regular(path, tail=True) if path else None
        if not got:
            return ""
        lines = got[0].decode("utf-8", "replace").split("\n")
        if got[1]:
            lines = lines[1:]                 # began mid-line
        found = {}
        for line in reversed(lines):
            if not any(f'"{kind}"' in line for kind, _k in _TITLE_KEYS):
                continue
            try:
                r = json.loads(line)
            except ValueError:
                continue
            kind = r.get("type") if isinstance(r, dict) else None
            key = dict(_TITLE_KEYS).get(kind)
            v = r.get(key) if key else None
            if kind in found or not (isinstance(v, str) and v.strip()):
                continue
            found[kind] = v
            if kind == "custom-title":
                break                             # nothing outranks it
        title = found.get("custom-title") or found.get("ai-title") or ""
        if not title and found.get("last-prompt"):
            title = next(ln for ln in found["last-prompt"].split("\n")
                         if ln.strip())
        return _clean(title)[:TITLE_MAX]
    except Exception:                             # noqa: BLE001
        return ""


def chat_age(secs):
    """Compact, the way the list prints it: 45s, 12m, 3h, 5d."""
    s = int(max(0, secs))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def _kept_only(rec, transcript):
    """(the kept copy or '', whether it is the ONLY copy, its size if so).

    THE ONLY COPY: Claude's is gone (`transcript` is where it was looked for)
    and nothing else links to the kept one. Deleting the record then deletes
    the conversation, and every confirmation has to say so."""
    kept = chat_kept(rec)
    if not kept or transcript:
        return kept, False, 0
    try:
        st = os.lstat(kept)
    except OSError:
        return kept, False, 0
    return kept, st.st_nlink == 1, st.st_size if st.st_nlink == 1 else 0


def _chat_facts(rec, live, now=None):
    """What the list and the menus say about one chat, looked up once."""
    now = time.time() if now is None else now
    tr = chat_transcript(rec)
    kept, only, size = _kept_only(rec, tr)
    return {"transcript": tr, "kept": kept, "only": only, "only_bytes": size,
            "status": chat_status(rec, live),
            "title": chat_title(rec, tr or kept),
            "age": chat_age(now - rec["last_active"]) if rec["last_active"]
            else "-"}


def _copies(facts):
    """The sentence every delete confirmation carries: is this the last copy?"""
    if facts["only"]:
        return "this is the only copy of the conversation — there is no undo"
    if facts["transcript"] or facts["kept"]:
        return "Claude Code keeps its own copy of the transcript"
    return "its transcript is gone already — only the record goes"


def _mb(n):
    return f"{n / 1e6:.1f} MB" if n >= 50000 else "<0.1 MB"


def _plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


def _stays(n):
    return "stays" if n == 1 else "stay"


def _history_footer(recs, facts, short=False):
    """`<dir> · N chats`, and how much of it exists nowhere else. `short`
    writes the home directory as ~, for a screen whose width cuts the end of the
    line -- which is where the count is."""
    where = history_dir()
    home = os.path.expanduser("~")
    if short and home not in ("", "/") and where.startswith(home + os.sep):
        where = "~" + where[len(home):]
    out = f"{printable(where)} · {_plural(len(recs), 'chat')}"
    only = sum(f["only_bytes"] for f in facts)
    if only:
        out += f" · {_mb(only)} kept only here"
    return out


def _cut(text, room):
    """Plain text in at most `room` columns, a cut ending in '…': clip()
    without its colour reset, for a string that is about to be escaped."""
    return _ANSI.sub("", clip(text, room))


def _pad(text, width):
    t = _cut(text, width)
    return t + " " * max(0, width - vis_width(t))


def forget_chats(ids):
    """Forget chats: unlink each record and its kept transcript, HERE.
    Returns (ids now gone, error lines). A file already gone counts as gone.

    THE KEPT TRANSCRIPT GOES FIRST. If anything fails half way, what is left
    is a record you can see and delete again -- never a transcript nobody lists,
    holding disk space out of sight."""
    root = history_dir()
    gone, errors = [], []
    for conv in ids:
        if not (isinstance(conv, str) and _UUID.fullmatch(conv)):
            errors.append(f"{show_name(str(conv))}: not a chat id")
            continue
        for ext in (".jsonl", ".json"):
            try:
                os.unlink(os.path.join(root, conv + ext))
            except FileNotFoundError:
                pass
            except OSError as exc:
                errors.append(f"{conv[:8]}: could not delete {conv}{ext}: "
                              f"{exc.strerror or exc}")
                break
        else:
            gone.append(conv)
    return gone, errors


def history_on_account(cfg_dir):
    """How many kept chats ran under the account profile at `cfg_dir`."""
    try:
        want = os.path.realpath(cfg_dir)
        return sum(1 for r in load_history() if r["config_dir"]
                   and os.path.realpath(r["config_dir"]) == want)
    except (OSError, ValueError):
        return 0


def history_account_note(n):
    """What deleting a profile does to History: nothing, and it says so. The
    kept transcripts are hard links of their own, so they outlive the profile
    -- which is the point -- until you delete them from History too."""
    if n == 1:
        return ("1 chat in History was on this account — its kept transcript "
                "stays until you delete it there")
    return (f"{n} chats in History were on this account — their kept "
            f"transcripts stay until you delete them there")


def _history_state():
    """(records, live conversation ids, whether a daemon answered)."""
    snap = _queue_snapshot()
    return load_history(), live_conversations(snap), snap is not None


def _index_of(recs, want):
    """The list index an argument is, or None for anything else: all ASCII
    digits, and smaller than the list (nine digits at most, so int() is never
    handed a number too long to convert)."""
    w = want.strip()
    return (int(w) if re.fullmatch(r"[0-9]{1,9}", w) and int(w) < len(recs)
            else None)


def _address(recs, want):
    """The chat an argument names: (record, None), or (None, why not).

    AN INDEX OR AN ID, never a name. Every chat in one project has that
    project's name, so a name says nothing about WHICH one -- and the index is
    only the list `claude-mate history` printed last time, which reorders as
    chats run (so `rm` has its id typed back, and `resume` by index says which
    chat it is and asks first). An all-digit argument smaller than the list is
    that index; anything else is the start of an id, at least four hex digits,
    and it must match exactly one chat."""
    w = want.strip().lower()
    i = _index_of(recs, w)
    if i is not None:
        return recs[i], None
    if not re.fullmatch(r"[0-9a-f-]{4,36}", w):
        return None, (f"no chat {show_name(want)}: give its number from "
                      f"`claude-mate history`, or 4+ characters of its id")
    hits = [r for r in recs if r["conversation"].startswith(w)]
    if not hits:
        return None, f"no chat with an id starting {w}"
    if len(hits) > 1:
        return None, (f"{w} matches {len(hits)} chats ("
                      + ", ".join(r["conversation"][:8] for r in hits)
                      + ") -- give more of the id")
    return hits[0], None


def _chat_item(rec, facts, room):
    """A chat as a chooser row: what it is about, then where and how it is."""
    name = _clean(rec["name"]) or "?"
    acct = _clean(rec["account"]) or "-"
    return Item(_cut(facts["title"] or name, room), value=("chat", rec),
                detail=f"{name} · {facts['status']} {facts['age']} · {acct}")


def _choose_chat(title, recs, live):
    """A chooser over the kept chats, for a subcommand given no chat. The
    record, or None for cancelled."""
    if not recs:
        die("claude-mate history: no chats kept yet")
    room = max(20, (shutil.get_terminal_size((80, 24)).columns - 1) // 2)
    now = time.time()
    items = [_chat_item(r, _chat_facts(r, live, now), room) for r in recs]
    items.append(Item("Cancel", value=("cancel", None), gap=True))
    got = pick(title, items, hint="↑↓ move   ⏎ choose   esc cancel")
    return got[1] if got and got[0] == "chat" else None


HISTORY_USAGE = """\
usage: claude-mate history                the chats it has kept, newest first
       claude-mate history resume <n|id>  pick one up again, where and as it was
                    [--skip-permissions|--ask-permissions]
       claude-mate history rm <n|id>      forget one, after typing its id back
       claude-mate history clear          forget every chat that is not open"""

STATUS_COLOUR = {"open": "done", "interrupted": "waiting"}   # closed: dim


def cmd_history(argv):
    if not argv:
        return _history_list()
    sub, rest = argv[0], argv[1:]
    if sub in ("rm", "remove", "delete"):
        return _history_rm(rest)
    if sub == "resume":
        return _history_resume(rest)
    if sub == "clear":
        return _history_clear()
    if sub in ("-h", "--help", "help"):
        print(HISTORY_USAGE)
        return 0
    die(f"claude-mate history: unknown subcommand {show_name(sub)}\n"
        + HISTORY_USAGE)


def _history_list():
    recs, live, alive = _history_state()
    if not recs:
        print(f"{D}no chats kept yet. a chat is kept after its first turn in a "
              f"wrapped session.{OFF}")
        return 0
    now = time.time()
    facts = [_chat_facts(r, live, now) for r in recs]
    names = [_clean(r["name"]) or "?" for r in recs]
    accts = [_clean(r["account"]) or "-" for r in recs]
    nw = max(vis_width(n) for n in names)
    aw = max(vis_width(a) for a in accts)
    # Cut to the terminal on a terminal, so a long title cannot wrap a row into
    # two -- and a name past 24 columns or an account past 16 cut first, so
    # they cannot push the title off it. A pipe gets every character of both,
    # since whatever reads it may want them: padded to line up, never cut.
    room = (shutil.get_terminal_size((80, 24)).columns - 1
            if sys.stdout.isatty() else None)
    if room:
        nw, aw = min(nw, 24), min(aw, 16)
    for i, (r, f) in enumerate(zip(recs, facts)):
        col = COLOUR.get(STATUS_COLOUR.get(f["status"], "idle"), "")
        line = (f"{i:>3}  {r['conversation'][:8]}  {col}{f['status']:<11}{OFF}"
                f"  {f['age']:>3}  {_pad(names[i], nw)}  "
                f"{D}{_pad(accts[i], aw)}{OFF}  {f['title']}")
        print(clip(line, room) if room else line)
    print(f"\n{D}{_history_footer(recs, facts)}{OFF}")
    if not alive:
        print(f"{D}(daemon not running: liveness from the terminals' context "
              f"files){OFF}")
    return 0


def _history_rm(rest):
    recs, live, _alive = _history_state()
    if not rest:
        # ASK, RATHER THAN SCOLD -- accounts rm's rule, for the same reason.
        if not supports_ui():
            die("claude-mate history rm: which chat? "
                "(see `claude-mate history`)")
        rec = _choose_chat("FORGET WHICH CHAT?", recs, live)
        if rec is None:
            print("not deleted.")
            return 1
    else:
        rec, why = _address(recs, rest[0])
        if rec is None:
            die(f"claude-mate history: {why}")
    if rec["conversation"] in live:
        die("claude-mate history rm: still open — it would come back on its "
            "next turn; close it first")
    f = _chat_facts(rec, live)
    print(f"\n{B}This forgets a chat.{OFF}")
    print(f"  id       {rec['conversation']}")
    print(f"  title    {f['title'] or '(none)'}")
    print(f"  name     {_clean(rec['name']) or '?'}")
    print(f"  cwd      {printable(rec['cwd']) or '?'}")
    print(f"  account  {_clean(rec['account']) or '-'}")
    print(f"  status   {f['status']}")
    print(f"\n{D}{_copies(f)}.{OFF}")
    # TYPE ITS ID. accounts rm types the NAME back, and that works there because
    # account names are unique. Chat names are not -- every chat in a project
    # has the project's -- and an index shifts as chats run, so the only thing
    # that proves which chat you mean is its id.
    token = rec["conversation"][:8]
    try:
        typed = input(f"\ntype its id, {B}{token}{OFF}, to confirm: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    if typed.lower() != token:
        print("not deleted.")
        return 1
    _gone, errors = forget_chats([rec["conversation"]])
    for e in errors:
        print(f"claude-mate history: {e}", file=sys.stderr)
    if errors:
        return 1
    print(f"forgot {token}.")
    return 0


def _history_clear():
    recs, live, _alive = _history_state()
    go = [r for r in recs if r["conversation"] not in live]
    stay = len(recs) - len(go)
    if not go:
        print("nothing to clear" + (f": {_plural(stay, 'open chat')}, and an "
                                    f"open chat is never forgotten"
                                    if stay else "") + ".")
        return 0
    only = sum(1 for r in go if _kept_only(r, chat_transcript(r))[1])
    print(f"\n{B}This forgets {_plural(len(go), 'chat')}.{OFF}")
    if only:
        are = "is" if only == 1 else "are"
        print(f"  {only} of them {are} the only copy of the conversation — "
              f"there is no undo.")
    else:
        print(f"  {D}none of them holds the only copy of a conversation.{OFF}")
    if stay:
        print(f"  {D}{_plural(stay, 'open chat')} {_stays(stay)}: an open chat would "
              f"come back on its next turn.{OFF}")
    try:
        typed = input(f"\ntype {B}clear{OFF} to confirm: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    if typed != "clear":
        print("not deleted.")
        return 1
    gone, errors = forget_chats([r["conversation"] for r in go])
    for e in errors:
        print(f"claude-mate history: {e}", file=sys.stderr)
    print(f"forgot {_plural(len(gone), 'chat')}.")
    return 1 if errors else 0


def _history_resume(rest):
    mode, args = "as-started", []
    for a in rest:
        want = {"--skip-permissions": "skip", "--ask-permissions": "ask"}.get(a)
        if want:
            if mode not in ("as-started", want):
                die("claude-mate history resume: --skip-permissions or "
                    "--ask-permissions, not both")
            mode = want
        elif a.startswith("-"):
            die(f"claude-mate history resume: unknown option {show_name(a)}\n"
                + HISTORY_USAGE)
        else:
            args.append(a)
    if len(args) > 1:
        die("claude-mate history resume: one chat at a time")
    recs, live, _alive = _history_state()
    if not args:
        if not supports_ui():
            die("claude-mate history resume: which chat? "
                "(see `claude-mate history`)")
        rec = _choose_chat("RESUME WHICH CHAT?", recs, live)
        if rec is None:
            return 1
    else:
        rec, why = _address(recs, args[0])
        if rec is None:
            die(f"claude-mate history: {why}")
        if _index_of(recs, args[0]) is not None:
            # BY NUMBER, IT SAYS WHICH CHAT FIRST. The number is the list
            # `claude-mate history` printed a while ago, and that reorders as
            # chats run: one new chat's first turn and `resume 1` is another
            # chat -- same project, same name, perhaps skipping permissions
            # -- and the prompt you type next goes into it. An id cannot
            # shift, and goes straight on.
            if not (sys.stdin.isatty() and sys.stdout.isatty()):
                die(f"claude-mate history resume: {NO_TTY}")
            f = _chat_facts(rec, live)
            print(f"\n{B}{rec['conversation'][:8]}{OFF}  "
                  f"{f['title'] or _clean(rec['name']) or '(no title)'}")
            print(f"  {D}in {printable(rec['cwd']) or '?'}{OFF}")
            try:
                typed = input("\npress enter to resume it, ctrl-c to stop: ")
            except (EOFError, KeyboardInterrupt):
                print()
                return 130
            if typed.strip():
                print("not resumed.")
                return 1
    why = resume_chat(rec, mode, live=live, ask=_ask_typed)
    if not why:
        print("not resumed.")
        return 1
    die(f"claude-mate history resume: {why}")


def _ask_typed(question):
    """resume_chat's question at a shell prompt: True for a typed `yes` and
    for nothing else; end of input or ctrl-c is 130, as at every prompt here."""
    print(f"\n{question}.")
    try:
        typed = input(f"\ntype {B}yes{OFF} to resume it anyway: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        raise SystemExit(130)
    return typed == "yes"


# ---------------------------------------------------------------------------
# The daemon, as something you can start rather than be told about
# ---------------------------------------------------------------------------
# THROUGH LAUNCHD, ALWAYS, and never by spawning the daemon directly. There is
# no pidfile, no flock and no single-instance guard anywhere in the daemon --
# and SocketServer.run() UNLINKS the socket path before binding it. So a second
# instance does not fail, it silently steals the socket from the first, while
# the first keeps the serial port: the CLI then talks to a daemon with no
# device, and the device is driven by a daemon nothing can reach. That is a
# genuinely horrible afternoon, and one `launchctl` call away from impossible.

def daemon_alive():
    """Is a daemon answering? `queue` is the only liveness proof there is.

    The socket has no ping, status or version verb -- seven verbs, and anything
    unrecognised is parsed as a session update and dropped -- so the honest test
    is to ask it something real and see whether JSON comes back.
    """
    reply = talk("queue", timeout=2.0)
    if reply is None:
        return False
    try:
        json.loads(reply)
        return True
    except ValueError:
        return False


def launchd_loaded():
    """Is the LaunchAgent bootstrapped? `launchctl list` exits 113 if not."""
    try:
        return subprocess.call(["launchctl", "list", LAUNCHD_LABEL],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0
    except OSError:
        return False


def start_daemon():
    """Start (or restart) the daemon through its LaunchAgent. Returns a note.

    THE ORDER MATTERS AND THE OLD ADVICE WAS WRONG. Every error path in this
    project used to print `launchctl bootstrap gui/$UID ...`, which fails with
    "Bootstrap failed: 5: Input/output error" whenever the job is ALREADY
    loaded -- which is the common case, because the installer loads it. So the
    one instruction we gave people worked only on the machine where it was
    least needed. packaging/scripts/postinstall already had the modern
    sequence; this is that sequence, and the other call sites now point here.
    """
    if not os.path.exists(LAUNCHD_PLIST):
        return (f"no LaunchAgent at {LAUNCHD_PLIST}\n"
                f"  run the installer first:  ./install/install.sh")
    # THE ONE FAILURE launchd CANNOT NARRATE. Every other crash writes something
    # to StandardErrorPath, so why_the_daemon_died() can read it back. A missing
    # or non-executable ProgramArguments[0] is different: launchd never gets far
    # enough to open our stderr, so it retries forever and the log stays empty.
    # Pinning the daemon to a virtualenv (which the installer now does, so a
    # Python upgrade cannot separate the interpreter from its packages) makes
    # this the failure mode you hit if the base Python is later REMOVED --
    # cheap to detect here, and invisible everywhere else.
    interp = daemon_interpreter()
    if interp and not os.access(interp, os.X_OK):
        return (f"the LaunchAgent's interpreter is gone:\n"
                f"    {interp}\n"
                f"  Its Python was probably removed or upgraded. Re-run the "
                f"installer to rebuild it:\n"
                f"    ./install/install.sh")
    dom = f"gui/{os.getuid()}"
    run = lambda *a: subprocess.call(list(a), stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
    if not launchd_loaded():
        run("launchctl", "bootstrap", dom, LAUNCHD_PLIST)
    run("launchctl", "enable", f"{dom}/{LAUNCHD_LABEL}")
    # -k so an already-running job is restarted rather than left as it was;
    # this is also the "it is wedged, kick it" path.
    run("launchctl", "kickstart", "-k", f"{dom}/{LAUNCHD_LABEL}")
    # The daemon opens its socket a moment after launchd forks it. Wait, rather
    # than reporting a failure that is really just impatience.
    for _ in range(40):
        if daemon_alive():
            return None
        time.sleep(0.1)
    # SAY WHY, DO NOT POINT AT A LOG. "check the log" is what this returned for
    # 1786 consecutive crash-loop restarts on a real machine, while the reason --
    # a one-line ModuleNotFoundError -- sat in that log the whole time. If we
    # know how to find the answer, printing the path instead of the answer is
    # just making the user do our job.
    reason = why_the_daemon_died()
    if reason:
        return ("started it, but it exited immediately:\n"
                + reason
                + f"\n  full log:  tail -f {LAUNCHD_ERR_LOG}")
    return ("started it, but nothing is answering on the socket yet.\n"
            f"  check the log:  tail -f {LAUNCHD_ERR_LOG}")


def daemon_interpreter(plist_path=None):
    """ProgramArguments[0] from the LaunchAgent, or None if it cannot be read.

    Forgiving on purpose: a plist we cannot parse must not stop a start we could
    otherwise have made.
    """
    try:
        import plistlib
        with open(plist_path or LAUNCHD_PLIST, "rb") as fh:
            argv = plistlib.load(fh).get("ProgramArguments") or []
        return argv[0] if argv else None
    except Exception:
        return None


def why_the_daemon_died(log_path=None, max_lines=12):
    """The tail of the daemon's stderr, trimmed to the part that explains a death.

    Returns an indented block ready to print, or None if the log says nothing
    useful. Deliberately forgiving: this runs on an error path, and a diagnostic
    that can itself raise turns a bad message into no message at all.
    """
    path = log_path or LAUNCHD_ERR_LOG
    try:
        with open(path, "rb") as fh:
            # The log is capped at 8 MB by the daemon, but read from the end
            # anyway -- the cap is best-effort and this must stay cheap.
            try:
                fh.seek(-16384, os.SEEK_END)
            except OSError:
                fh.seek(0)
            tail = fh.read().decode("utf-8", "replace")
    except OSError:
        return None

    lines = [ln.rstrip() for ln in tail.splitlines() if ln.strip()]
    if not lines:
        return None

    # A Python traceback is the interesting case and it reads bottom-up: the
    # exception is the LAST line, the "Traceback (most recent call last):" that
    # starts it may be far above. Take from the last traceback header onwards so
    # the exception keeps the frames that led to it.
    start = 0
    for i in range(len(lines) - 1, -1, -1):
        if lines[i].startswith("Traceback (most recent call last)"):
            start = i
            break
    else:
        # No traceback: show the trailing ERROR lines if there are any, else the
        # plain tail. Either way the last few lines are what just happened.
        errs = [ln for ln in lines if "ERROR" in ln or "Error" in ln]
        if errs:
            lines = errs
        start = max(0, len(lines) - max_lines)

    block = lines[start:][-max_lines:]
    return "\n".join("    " + ln for ln in block)


# ---------------------------------------------------------------------------
# Terminal plumbing
# ---------------------------------------------------------------------------
# ALL OF IT MOVED TO claude_mate_ui, and that is the point of this change rather
# than a tidy-up. The top level had arrow keys and every level underneath it
# still asked you to read a number off a list and type it; the only way to fix
# that once is for the submenus, `accounts rm` and the wrapper's own account
# picker to call the SAME chooser. See the note at the top of that module -- it
# is also a bug fix, because a prompt you type names into is how a profile
# called "\033" came to exist.
# THE MACHINERY ONLY, AND NOT THE COLOURS. Importing B/D/OFF from here would
# re-bind the names this file blanked for a non-TTY forty lines above, and put
# escape codes back into every pipe -- which is exactly what it did until the
# test caught it. The module keeps its own copies for its own rendering.
from claude_mate_ui import (                                    # noqa: E402
    Item, Term, confirm, pick, printable, read_key, supports_ui,
    _ANSI, _cells, clip, vis_width,
)

# ---------------------------------------------------------------------------
# Starting a session
# ---------------------------------------------------------------------------
# WHAT THE MENU ITEM ACTUALLY DOES: exactly what the maintainer types today,
# `claude --dangerously-skip-permissions`, but through the wrapper so the
# session is reported to the daemon and shows up on the device. Bare `claude`
# would run untracked and the whole point of the project would miss it.
#
# It EXECs rather than forking. The wrapper takes raw mode on this terminal's
# stdin itself and needs both fds to be real TTYs or it silently degrades to
# unwrapped claude; handing it the process rather than sitting above it as a
# parent avoids two programs negotiating over one terminal. The precedent is
# claude-mate-switch, which re-execs the wrapper the same way when it moves a
# conversation to another account.
#
# TWO ITEMS, NOT A HIDDEN DEFAULT. Skipping permission prompts is a real
# decision and this is somebody else's machine as often as it is ours, so the
# menu says which one it is doing rather than quietly picking. Anything else
# goes in CLAUDE_MATE_NEW_ARGS.
#
# A RESUMED CHAT COMES THROUGH HERE TOO, which is what `cwd`, `env` and `verb`
# are for: `claude --resume <id>` finds the conversation through the directory
# it is run in, and the login through CLAUDE_CONFIG_DIR. ValueError as well as
# OSError, because that is what execve() raises for a NUL in an argument, and a
# traceback after the terminal has been handed back is no way to say so.
def exec_new_session(extra_argv, term=None, cwd=None, env=None,
                     verb="starting"):
    if term is not None:
        term.restore()
    if not os.path.exists(WRAP):
        die(f"claude-mate: cannot find the wrapper at {WRAP}")
    argv = [sys.executable, WRAP] + list(extra_argv)
    print(f"{D}{verb}: claude {printable(' '.join(extra_argv))}{OFF}\n")
    sys.stdout.flush()
    try:
        if cwd:
            os.chdir(cwd)
        os.execve(sys.executable, argv,
                  dict(os.environ) if env is None else env)
    except (OSError, ValueError) as exc:
        die(f"claude-mate: could not start the wrapper: {exc}")


# ---- resuming a kept chat ----------------------------------------------- #
_WRAPPER = []           # the wrapper as a module, once loaded


def _wrapper():
    """The wrapper, loaded by path, for the policy a resume replays flags by.

    ONE POLICY, AND IT IS THE WRAPPER'S. Which launch flags make a resumed
    session the same kind of session -- permission mode, model, effort, yes; a
    prompt, which would be SENT AGAIN, or -w, which makes a new worktree, no --
    is decided once, in resume_flags(), for a chat resumed days later from its
    record -- stricter than the account switch's own rule, which carries a
    session on the spot and stores nothing. Loaded the way claude-mate-switch
    loads it (an executable with no .py,
    everything that starts a session behind its __main__ guard), and only when
    a resume needs it."""
    if not _WRAPPER:
        # FROM A DIRECTORY THAT IS STILL THERE. The wrapper names its session
        # after os.getcwd() as it loads, and in a directory deleted under this
        # shell (a removed worktree, a cleaned-up temp dir) that raises: every
        # resume was refused as "cannot load the wrapper ... No such file or
        # directory" for a wrapper that was right there, and the chat menu
        # lost the flags it labels Resume by. So it loads from ~ -- a resume
        # runs in the chat's own directory anyway.
        try:
            os.getcwd()
        except OSError:
            os.chdir(os.path.expanduser("~"))
        name = "cm_wrap"
        spec = importlib.util.spec_from_loader(
            name, importlib.machinery.SourceFileLoader(name, WRAP))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _WRAPPER.append(mod)
    return _WRAPPER[0]


def _flag_items(flags, cwd=None):
    """A kept chat's flags as the wrapper parses them -- one item per flag,
    WITH its values (resume_flag_items) -- or [] when the wrapper cannot load.

    NEVER WORD BY WORD. In `--name --dangerously-skip-permissions` the second
    word is the session's name: a scan for the permission flag reads a bypass
    the chat never had, and taking that word out leaves `--name` to swallow the
    `--resume` behind it -- a NEW session, with the id as its first prompt."""
    try:
        return [list(it) for it in
                _wrapper().resume_flag_items(list(flags or []), cwd=cwd)]
    except Exception:                                 # noqa: BLE001
        return []


def _permission_mode_of(item):
    """The mode a `--permission-mode` item sets, either spelling; None for
    any other flag."""
    if item[0].split("=", 1)[0] != "--permission-mode":
        return None
    if "=" in item[0]:
        return item[0].split("=", 1)[1]
    return item[1] if len(item) > 1 else ""


def _skip_items(items):
    """Do these items start a session that asks no permission? Both ways of
    saying so count -- a record that bypasses through --permission-mode must
    not be offered a plain Resume that quietly bypasses too."""
    return any(it[0] == "--dangerously-skip-permissions"
               or _permission_mode_of(it) == "bypassPermissions"
               for it in items)


def skips_permissions(flags, cwd=None):
    """_skip_items() for a list of flags, parsed the wrapper's way first."""
    return _skip_items(_flag_items(flags, cwd))


def _label_of(cfg):
    """The wrapper's account_label() rule, for a config dir we hold rather
    than one in the environment."""
    return os.path.basename(os.path.normpath(cfg)).lstrip(".") or "default"


NO_TTY = ("resume needs a terminal on both ends: the wrapper would run claude "
          "unwrapped, untracked")
OPEN_NOW = ("it is open in a terminal — raise it instead; resuming it twice "
            "would write one transcript from two places")
RECENT_WRITE_S = 120.0    # a transcript written this lately may have a writer
                          # nothing here can see: ask before resuming it


def _written_ago(path):
    """Seconds since `path` was last written, or None when that is unknown."""
    try:
        return time.time() - os.stat(path).st_mtime
    except (OSError, ValueError):
        return None


def resume_chat(rec, mode, term=None, live=None, ask=None):
    """Pick a kept chat up again, where and as it was. Returns why not -- the
    app shows it as a note, the CLI dies with it -- or '' when `ask` was
    answered no, or never returns.

    mode: "as-started" replays the flags it was started with; "skip" swaps any
    permission mode for --dangerously-skip-permissions; "ask" drops every way
    of skipping them.

    `live` is chats the caller already knows are open: it is ADDED to a fresh
    look, never taken instead of one. `ask(question)` goes on only on True --
    it is how a transcript written moments ago is put to a person (see
    RECENT_WRITE_S); with no `ask`, that question is a refusal.

    EVERYTHING IS CHECKED BEFORE THE TERMINAL IS HANDED OVER, because nothing
    can be said after the exec, and claude's own answer to most of these -- "No
    conversation found with session ID" -- names none of the causes. Each
    refusal says what was checked."""
    conv = rec["conversation"]
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return NO_TTY
    known = set(live or ())
    if conv in known | live_conversations(_queue_snapshot()):
        return OPEN_NOW
    cfg = rec["config_dir"]
    found, base = _locate(rec)
    kept = chat_kept(rec)
    if cfg and not os.path.isdir(cfg):
        gone = (f"its account profile {_clean(_label_of(cfg))} no longer "
                f"exists ({printable(cfg)})")
        if kept:
            # NOT MADE AGAIN FROM HERE. The kept link is the whole
            # conversation, but the login went with the profile: a resume
            # into a bare directory would start claude logged out, as an
            # account that is not the one the chat ran as.
            return (f"{gone} — the conversation is kept; recreate the profile "
                    f"and log in to resume it as that account")
        return (f"{gone}, and no copy of the conversation was kept in "
                f"{printable(history_dir())}")
    if not found and not kept:
        where = " or ".join(printable(os.path.join(b, "projects"))
                            for b in _search_bases(rec))
        return (f"no {conv[:8]}….jsonl under {where}, and none kept in "
                f"{printable(history_dir())}. Claude Code may have cleaned it "
                f"up (cleanupPeriodDays), `claude purge` may have removed it, "
                f"or the profile it lived in may have been deleted")
    try:
        W = _wrapper()
        recorded = W.transcript_cwd(found or kept)
    except Exception as exc:                          # noqa: BLE001
        return (f"cannot load the wrapper from {printable(WRAP)}: "
                f"{printable(str(exc))}")
    # THE TRANSCRIPT'S OWN cwd FIRST. It is where claude was really running --
    # under -w that is the worktree, not the directory the wrapper started in
    # -- and it is the directory --resume looks the conversation up through.
    cwd = next((c for c in (recorded, rec["cwd"])
                if isinstance(c, str) and c.startswith("/")
                and os.path.isdir(c)), "")
    if not cwd:
        return (f"its directory {printable(recorded or rec['cwd'] or '?')} no "
                f"longer exists — claude finds the conversation through it; "
                f"recreate it, or delete the record")
    try:
        # Through the policy AGAIN, not replayed as stored: a record is a file,
        # and what reaches execve() is decided by the wrapper's rules of today.
        # As ITEMS, so the permission mode is swapped a whole flag at a time.
        items = [list(it) for it in
                 W.resume_flag_items(list(rec["flags"] or []), cwd=cwd)]
    except Exception as exc:                          # noqa: BLE001
        return (f"cannot load the wrapper's resume rules from "
                f"{printable(WRAP)}: {printable(str(exc))}")
    if mode == "skip":
        if any(it[0] == "--restricted" for it in items):
            return ("it was started with --restricted, which refuses to skip "
                    "permission prompts")
        items = [it for it in items if _permission_mode_of(it) is None]
        if not any(it[0] == "--dangerously-skip-permissions" for it in items):
            items.append(["--dangerously-skip-permissions"])
    elif mode == "ask":
        items = [it for it in items
                 if it[0] != "--dangerously-skip-permissions"
                 and _permission_mode_of(it) != "bypassPermissions"]
    flags = [w for it in items for w in it]

    env = dict(os.environ)
    if cfg is None:
        # Not recorded: run it as the login it was found under.
        cfg = "" if os.path.realpath(base or os.path.expanduser("~/.claude")) \
            == os.path.realpath(os.path.expanduser("~/.claude")) else base
    if cfg:
        # VERBATIM. Claude hashes the exact string into its Keychain entry, so
        # CLAUDE_CONFIG_DIR=~/.claude is a different login from no variable.
        env["CLAUDE_CONFIG_DIR"] = cfg
        label = _label_of(cfg)
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)
        label = "default"
    env["CLAUDE_MATE_ACCOUNT"] = label

    # A TRANSCRIPT SOMETHING IS STILL WRITING. "Open" is only what claude-mate
    # can see: a wrapped terminal that knows its chat. claude run without the
    # wrapper, the VS Code panel, a chat opened by -r <name> or by claude's
    # own picker before its first turn -- none of them says which chat it
    # has, and a second claude on it forks the transcript all the same. What
    # every one of them does leave is a fresh write, so a chat written
    # moments ago is a question for the person, never a silent go.
    ago = _written_ago(found or kept)
    if ago is not None and ago < RECENT_WRITE_S:
        question = (f"its transcript was written {chat_age(ago)} ago and no "
                    f"terminal claude-mate can see has it — one it cannot see "
                    f"may (claude run without the wrapper, the VS Code panel, "
                    f"or a session opened by -r or the picker that has not "
                    f"run a turn yet); resuming it twice writes one "
                    f"transcript from two places")
        if ask is None:
            return question
        if not ask(question):
            return ""
    # AND OPEN IS LOOKED AT AGAIN, RIGHT BEFORE ANYTHING IS DONE. What was
    # read before -- by the caller, before a chooser, before a question that
    # waited on a person -- is as old as that wait, and a chat opened in
    # another terminal meanwhile would get a second claude.
    if conv in known | live_conversations(_queue_snapshot()):
        return OPEN_NOW

    if not found:
        # BACK FROM THE KEPT LINK. Claude's copy is gone -- cleaned up after
        # cleanupPeriodDays, purged, or deleted with its profile (made again
        # since) -- and the one kept here is the conversation. Put it where
        # --resume looks: the directory it was last seen in, else Claude's
        # mangling of the cwd. A link costs no space; across volumes, a copy.
        proj = rec["project"] or re.sub(r"[^a-zA-Z0-9]", "-", cwd)
        dst = os.path.join(cfg or os.path.expanduser("~/.claude"),
                           "projects", proj, conv + ".jsonl")
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            try:
                os.link(kept, dst)
            except FileExistsError:
                pass                      # someone put it back meanwhile
            except OSError:
                shutil.copy2(kept, dst)
        except OSError as exc:
            return (f"could not put the kept transcript back at "
                    f"{printable(dst)}: {exc.strerror or exc}")

    if term is not None:
        term.restore()
    print(f"resuming: {_clean(rec['name']) or conv[:8]} in {printable(cwd)} "
          f"as {_clean(label)}")
    exec_new_session(flags + ["--resume", conv], cwd=cwd, env=env,
                     verb="resuming")
    return "the wrapper did not start"      # exec_new_session never returns


def extra_new_args():
    raw = os.environ.get("CLAUDE_MATE_NEW_ARGS", "").strip()
    return raw.split() if raw else []


# ---------------------------------------------------------------------------
# The app
# ---------------------------------------------------------------------------
REFRESH_S = 1.0


def _rows(snap):
    """The screen as a flat list of selectable rows, sessions first."""
    rows = [{"kind": "session", "s": s} for s in (snap or {}).get("queue", [])]
    rows.append({"kind": "new", "label": "Start new session",
                 "argv": extra_new_args()})
    rows.append({"kind": "new", "label": "Start new session · skip permissions",
                 "argv": ["--dangerously-skip-permissions"] + extra_new_args()})
    # ONE ROW, AND NOTHING READ TO DRAW IT. The chats themselves are listed one
    # level down: on this screen they would push the rows below off an 80x24
    # terminal, and move under a cursor that is only a position.
    rows.append({"kind": "history",
                 "label": "History · resume or delete a past chat"})
    rows.append({"kind": "device", "label": "Device · link status and pairing"})
    rows.append({"kind": "accounts", "label": "Accounts · switch or review"})
    rows.append({"kind": "quit", "label": "Quit"})
    return rows


NOTE_ROWS = 3             # rows one line of the app's note may wrap to
_SGR_LEAD = re.compile(r"(?:\x1b\[[0-9;]*m)+")
_RESET = "\033[0m"


def _fits(text, room):
    """How many characters of `text` fit in `room` columns: colour codes
    cost none, a wide character two."""
    used, i = 0, 0
    while i < len(text):
        m = _ANSI.match(text, i)
        if m:
            i = m.end()
            continue
        w = _cells(text[i])
        if used + w > room:
            break
        used += w
        i += 1
    return i


def _wrap(text, room, most):
    """`text` as at most `most` rows of at most `room` columns, broken at a
    space in the second half of a row, else wherever the row is full (a long
    path would otherwise strand the word before it on a row of its own); the
    last row cut with '…' when it all does not fit."""
    rows = []
    while len(rows) < most - 1 and vis_width(text) > room:
        n = _fits(text, room)
        if text[n:n + 1] != " ":
            sp = text.rfind(" ", 0, n)
            n = sp if sp > n // 2 else max(n, 1)
        rows.append(text[:n].rstrip(" "))
        text = text[n:].lstrip(" ")
    return rows + [clip(text, room)]


def _note_rows(note, room, most=NOTE_ROWS):
    """A note as screen rows of at most `room` columns: each of its lines
    wrapped to at most `most` rows -- a note that brings its own line breaks
    (start_daemon's, with the reason the daemon died) keeps every line of it.
    A colour the note starts with starts every row, and every row ends in a
    reset, so no colour runs on past its row."""
    m = _SGR_LEAD.match(note)
    lead = m.group() if m else ""
    body = note[len(lead):]
    if body.endswith(_RESET):
        body = body[:-len(_RESET)]
    rows = [r for line in body.split("\n") for r in _wrap(line, room, most)]
    if not (lead or _ANSI.search(body)):
        return rows
    return [f"{lead}{r}{_RESET}" for r in rows]


def _draw(term, snap, sel, rows, note, alive):
    cols = term.size()[0]
    dot = f"{COLOUR['done']}●{OFF}" if alive else f"{COLOUR['error']}●{OFF}"
    state = "running" if alive else "not running"
    out = [
        f" {B}claude-mate{OFF}   {D}{dot} daemon {state}"
        f" · {time.strftime('%H:%M:%S')}{OFF}",
        "",
    ]
    sessions = [r for r in rows if r["kind"] == "session"]
    if sessions:
        width = max(len(r["s"]["name"]) for r in sessions)
        out.append(f" {D}SESSIONS{OFF}")
    elif alive:
        out.append(f" {D}no sessions yet — start one below{OFF}")
    else:
        out.append(f" {D}the daemon is not running, so there is nothing to"
                   f" show yet{OFF}")
    for i, r in enumerate(rows):
        here = f"{B}▸{OFF}" if i == sel else " "
        if r["kind"] == "session":
            s = r["s"]
            col = COLOUR.get(s["state"], "")
            glass = f"{B}•{OFF}" if s.get("shown") else " "
            flag = "" if s.get("acked") else f"  {col}{B}needs you{OFF}"
            meta = [x for x in (s.get("model"), s.get("effort"),
                                s.get("account"), s.get("limit")) if x]
            head = (f" {here}{glass} {col}{s['name']:<{width}}  "
                    f"{s['state']:<7}{OFF} {mmss(s['secs']):>6}  ")
            line = f"{head}{D}{'  '.join(meta)}{OFF}{flag}"
            # Too wide: the meta goes from the end before anything is cut, so
            # "needs you" outlasts the account and the limit chip.
            while meta and vis_width(line) > cols - 1:
                meta.pop()
                line = f"{head}{D}{'  '.join(meta)}{OFF}{flag}"
            out.append(clip(line, cols - 1))
            # ONE line per session, however many runs it has: the one the
            # device's band shows (the daemon lists it first) and "+N more".
            # Display-only -- not a row, never selectable, and never carrying
            # the '▸' that marks the selected row.
            wfs = session_workflows(s)
            if wfs:
                out.append(_wf_line(wfs[0], len(wfs) - 1, cols - 1))
        else:
            if rows[i - 1]["kind"] == "session":
                out.append("")
            label = r["label"]
            body = f"{B}{label}{OFF}" if i == sel else label
            out.append(f" {here}  {body}")
    out.append("")
    if note:
        # FITTED LIKE EVERY OTHER LINE HERE. A note is whatever a level below
        # or a refusal had to say -- a resume refused because its directory is
        # gone runs to 175 columns -- and painted raw it wrapped, pushed the
        # frame past the bottom and scrolled the header off the top.
        out += [f" {r}" for r in _note_rows(note, cols - 2)]
        out.append("")
    if rows[sel]["kind"] == "session":
        out.append(f" {D}↑↓ move   ⏎ raise this session   a ack   f follow"
                   f"   m mirror   c continue{OFF}")
    else:
        out.append(f" {D}↑↓ move   ⏎ choose{OFF}")
    out.append(f" {D}r {'restart' if alive else 'start'} daemon   q quit{OFF}")
    return out


def cmd_app():
    """The arrow-key app. Only ever reached on a real terminal; see main()."""
    with Term() as term:
        sel, note, last_poll = 0, None, 0.0
        snap, alive = None, False
        while True:
            now = time.time()
            if now - last_poll >= REFRESH_S:
                last_poll = now
                alive = daemon_alive()
                snap = json.loads(talk("queue") or "null") if alive else None
            rows = _rows(snap)
            sel = max(0, min(sel, len(rows) - 1))
            term.paint(_draw(term, snap, sel, rows, note, alive))

            key = read_key(term.fd, timeout=0.25)
            if key is None:
                continue
            note = None
            row = rows[sel]
            if key in ("q", "ctrl-c", "eof"):
                return 0
            if key == "up":
                sel -= 1
                if sel < 0:
                    sel = len(rows) - 1
            elif key == "down":
                sel = (sel + 1) % len(rows)
            elif key == "home":
                sel = 0
            elif key == "end":
                sel = len(rows) - 1          # same keys as pick(), everywhere
            elif key == "r":
                note = f"{D}starting the daemon...{OFF}"
                term.paint(_draw(term, snap, sel, rows, note, alive))
                problem = start_daemon()
                note = (f"{COLOUR['error']}{problem}{OFF}" if problem
                        else f"{COLOUR['done']}daemon started{OFF}")
                last_poll = 0.0
            elif key == "enter":
                if row["kind"] == "quit":
                    return 0
                if row["kind"] == "new":
                    exec_new_session(row["argv"], term)     # never returns
                if row["kind"] == "device":
                    note = menu_device(term)
                    last_poll = 0.0
                elif row["kind"] == "accounts":
                    note = menu_accounts(term)
                    last_poll = 0.0
                elif row["kind"] == "history":
                    note = menu_history(term)
                    last_poll = 0.0
                elif row["kind"] == "session":
                    talk(f"select|{row['s']['name']}")
                    talk("press|G")
                    note = f"{D}raised {row['s']['name']}{OFF}"
                    last_poll = 0.0
            elif row["kind"] == "session" and key in APP_KEYS:
                talk(f"select|{row['s']['name']}")
                talk(f"press|{PRESSES[APP_KEYS[key]]}")
                note = f"{D}sent {key} to {row['s']['name']}{OFF}"
                last_poll = 0.0


# ---------------------------------------------------------------------------
# The levels underneath the top one
# ---------------------------------------------------------------------------
# THESE USED TO BE SHELL-OUTS AND THAT WAS THE COMPLAINT. "Accounts" ran
# `claude-mate-switch --help` and left you looking at an argparse usage block
# under a "press enter to go back"; "Device" dumped a four-screen report the
# same way. Both are arrow-driven menus now, built from the same pick() as the
# top level, so there is one set of keys in this program and esc always means
# back.

def _accounts_snapshot():
    reply = talk("accounts")
    if not reply:
        return None
    try:
        return json.loads(reply)
    except ValueError:
        return None


def menu_accounts(term):
    """The saved logins, and what you can do to one. Returns a note, or None."""
    while True:
        snap = _accounts_snapshot()
        if snap is None:
            return f"{COLOUR['error']}no daemon — cannot read the accounts{OFF}"
        accts = snap["accounts"]
        items = []
        for a in accts:
            email = read_email(a["name"], a["dir"]) or "(not logged in)"
            marks = [] if a["exists"] else ["missing"]
            # SAY WHEN A NAME IS UNTYPEABLE. This is where the "\033" profile
            # shows up, and the whole reason the old list was unusable: it
            # printed as a blank row, so the one account you wanted to delete
            # was the one you could not name.
            if show_name(a["name"]) != a["name"]:
                marks.append("unprintable name")
            items.append(Item(show_name(a["name"]) or "(blank)",
                              value=("acct", a),
                              detail="  ".join([email] + marks)))
        items.append(Item("Back", value=("back", None), gap=True))
        got = pick("ACCOUNTS", items, term=term,
                   hint="↑↓ move   ⏎ open   esc back",
                   note=f"{D}{printable(snap['accounts_dir'])}{OFF}")
        if got is None or got[0] == "back":
            return None
        note = menu_one_account(term, got[1])
        if note:
            return note


def menu_one_account(term, a):
    """What you can do to one login."""
    name = show_name(a["name"])
    email = read_email(a["name"], a["dir"]) or "(not logged in)"
    items = [Item("Use for the next new session", value="use",
                  detail="sets CLAUDE_MATE_ACCOUNT for a session started here")]
    if a["removable"]:
        items.append(Item("Delete this profile", value="rm", danger=True,
                          detail="its login and every transcript under it",
                          gap=True))
    items.append(Item("Back", value="back", gap=True))
    got = pick(f"ACCOUNT · {name}", items, term=term,
               note=f"{D}{printable(email)}\n {printable(a['dir'])}{OFF}".replace("\n", "\n "))
    if got == "use":
        os.environ["CLAUDE_MATE_ACCOUNT"] = a["name"]
        return (f"{COLOUR['done']}next new session will run as "
                f"{name}{OFF}")
    if got == "rm":
        return _delete_account(term, a)
    return None


def _delete_account(term, a):
    """Delete, behind a chooser rather than a typed name.

    The typed confirmation is right at a shell prompt -- typing the name proves
    you mean THAT one -- and wrong here, because the account most likely to need
    deleting is the one whose name cannot be typed. The chooser already proves
    which row you are on, so the second gate is the gesture, not the spelling:
    No is where the cursor starts.
    """
    name = show_name(a["name"])
    email = read_email(a["name"], a["dir"])
    in_history = history_on_account(a["dir"])
    # term=term: without it pick() opened a Term of its own, and restoring that
    # one took the app's screen out of the alternate buffer while it ran on.
    ok = confirm(
        f"DELETE {name}?",
        f"{printable(email) or '(not logged in)'} · {printable(a['dir'])} · there is no undo",
        term=term,
        note=(f"{D}{history_account_note(in_history)}{OFF}"
              .replace(" — ", " —\n ") if in_history else None))
    if not ok:
        return None
    try:
        shutil.rmtree(a["dir"])
    except OSError as e:
        return f"{COLOUR['error']}could not delete: {e}{OFF}"
    talk("accounts-refresh")
    return f"{COLOUR['done']}deleted {name}{OFF}"


def menu_history(term):
    """The chats the daemon has kept, newest first. Returns a note, or None.

    Read when it opens, and again each time you come back to the list -- never
    while it is on the screen, and never from the top level, which draws one
    row for all of it."""
    while True:
        recs = load_history()
        if not recs:
            return (f"{D}no chats kept yet. a chat is kept after its first "
                    f"turn in a wrapped session.{OFF}")
        live = live_conversations(_queue_snapshot())
        now = time.time()
        facts = [_chat_facts(r, live, now) for r in recs]
        # Titles cut to half the width, so one long title cannot pad every row
        # until the details are pushed off the edge.
        room = max(20, (term.size()[0] - 1) // 2)
        items = [_chat_item(r, f, room) for r, f in zip(recs, facts)]
        items.append(Item("Clear all history", value=("clear", None),
                          danger=True, gap=True,
                          detail="forget every chat that is not open"))
        items.append(Item("Back", value=("back", None), gap=True))
        got = pick("HISTORY", items, term=term,
                   hint="↑↓ move   ⏎ open   esc back",
                   note=f"{D}{_history_footer(recs, facts, short=True)}{OFF}")
        if got is None or got[0] == "back":
            return None
        if got[0] == "clear":
            note = _clear_history(term, recs, facts, live)
        else:
            note = menu_one_chat(term, got[1], live)
        if note:
            return note


def menu_one_chat(term, rec, live):
    """What you can do with one kept chat. Returns a note, or None.

    NO DIGITS HERE. A number would resume -- possibly skipping permissions --
    or reach Delete in one keystroke, with nothing in between to undo it."""
    conv = rec["conversation"]
    f = _chat_facts(rec, live)
    flag_items = _flag_items(rec["flags"], rec["cwd"] or None)
    flags = [w for it in flag_items for w in it]
    label = f["title"] or _clean(rec["name"]) or conv[:8]
    items = []
    if conv in live:
        items.append(Item("Raise its terminal", value="raise",
                          detail="it is open: bring that window forward"))
    elif f["transcript"] or f["kept"]:
        # THE PERMISSION MODE IS IN THE LABEL, NOT HIDDEN IN A DETAIL that the
        # width cuts first -- the same rule as the two Start rows on the top
        # level. A chat started skipping prompts says so before it does it.
        if _skip_items(flag_items):
            items.append(Item("Resume · skip permissions", value="as-started",
                              detail="as it was started"))
            items.append(Item("Resume · ask permissions", value="ask",
                              detail="the same flags, prompts back on"))
        else:
            items.append(Item("Resume", value="as-started",
                              detail=" ".join(flags) or "as it was started"))
            if not any(it[0] == "--restricted" for it in flag_items):
                items.append(Item("Resume · skip permissions", value="skip",
                                  detail="--dangerously-skip-permissions"))
    items.append(Item("Delete from history", value="rm", danger=True, gap=True,
                      detail=_copies(f)))
    items.append(Item("Back", value="back", gap=True))
    where = [_clean(rec["account"]) or "-", conv[:8],
             f"active {f['age']} ago" if f["age"] != "-" else "never active",
             f["status"]]
    if f["only"]:
        where.append("kept only here")
    elif not (f["transcript"] or f["kept"]):
        where.append("no transcript left to resume")
    got = pick(f"CHAT · {label}", items, term=term, digits=False,
               note=f"{D}{printable(rec['cwd']) or '?'}\n "
                    f"{' · '.join(where)}{OFF}")
    if got is None or got == "back":
        return None
    if got == "raise":
        return _raise_chat(rec)
    if got == "rm":
        if conv in live:
            return (f"{COLOUR['error']}still open — it would come back on its "
                    f"next turn; close it first{OFF}")
        ok = confirm(f"DELETE {label}?", _copies(f), term=term,
                     note=f"{D}{_clean(rec['name']) or '?'} · "
                          f"{printable(rec['cwd']) or '?'} · {conv[:8]}{OFF}")
        if not ok:
            return None
        _gone, errors = forget_chats([conv])
        if errors:
            return f"{COLOUR['error']}{printable('; '.join(errors))}{OFF}"
        return f"{COLOUR['done']}forgot {label}{OFF}"

    def ask(question):
        # No first and no digits (confirm()); the question as the note, since
        # the hint line is cut to the width and this one has to be read whole.
        note = "\n ".join(_note_rows(f"{D}{question}{OFF}",
                                     term.size()[0] - 2, most=6))
        return confirm(f"RESUME {label}?", "resume it anyway?", term=term,
                       note=note)

    problem = resume_chat(rec, got, term=term, ask=ask)  # returns only to stop
    if not problem:
        return None                 # asked, and the answer was no
    return f"{COLOUR['error']}{problem}{OFF}"


def _raise_chat(rec):
    """Bring an open chat's terminal forward: GO, on ITS row.

    By the row's key, re-read now -- not by a queue index from when the menu
    opened, which a session starting or ending since would have shifted onto
    another row -- and GO only once the daemon says that row is selected.
    Raising the wrong window is the one mistake select refuses to guess at.

    AND ONLY A ROW STILL BEING HEARD FROM, the freshest. A terminal killed
    outright keeps its row for minutes, and the chat resumed since, in the
    same directory, has a second row under the same name -- which of the two
    sorts first is a coin toss on their random keys. GO on the dead one
    brought VS Code forward instead, acknowledged a row nobody was in, and
    said it had raised the chat."""
    snap = _queue_snapshot()
    if snap is None:
        return (f"{COLOUR['error']}no daemon to raise it with — it is open "
                f"in a terminal, by that terminal's own record{OFF}")
    queue = snap.get("queue")
    rows = [s for s in (queue if isinstance(queue, list) else [])
            if isinstance(s, dict) and str(s.get("conversation") or "").lower()
            == rec["conversation"]]
    heard = sorted((s for s in rows if _heard(s)), key=_quiet)
    if rows and not heard:
        return (f"{COLOUR['error']}its terminal has stopped reporting to the "
                f"daemon (nothing for over {int(LIVE_REPORT_S)} s) — raising "
                f"that row could bring the wrong window forward{OFF}")
    entry = heard[0] if heard else None
    key = str((entry or {}).get("key") or "")
    if not key or any(c in key for c in "|\r\n"):
        return (f"{COLOUR['error']}the daemon has no row for it yet — it is "
                f"open, by its terminal's own record{OFF}")
    reply = talk(f"select|{key}") or ""
    if not reply.startswith("ok"):
        return (f"{COLOUR['error']}could not select it: "
                f"{printable(reply.strip() or 'no reply')}{OFF}")
    talk("press|G")
    return f"{D}raised {_clean(entry.get('name')) or printable(key)}{OFF}"


def _clear_history(term, recs, facts, live):
    """Forget every kept chat that is not open, behind one confirmation that
    says how many go and how many of them exist nowhere else."""
    go = [(r, f) for r, f in zip(recs, facts) if r["conversation"] not in live]
    stay = len(recs) - len(go)
    if not go:
        return f"{D}nothing to clear: every chat in it is open{OFF}"
    only = sum(1 for _r, f in go if f["only"])
    question = (f"{_plural(len(go), 'chat')} go · {only} of them the only copy "
                f"of the conversation — there is no undo" if only else
                f"{_plural(len(go), 'chat')} go · none of them the only copy "
                f"of a conversation")
    ok = confirm("CLEAR ALL HISTORY?", question, term=term,
                 note=(f"{D}{_plural(stay, 'open chat')} {_stays(stay)}{OFF}"
                       if stay else None))
    if not ok:
        return None
    gone, errors = forget_chats([r["conversation"] for r, _f in go])
    if errors:
        return (f"{COLOUR['error']}forgot {len(gone)}; "
                f"{printable('; '.join(errors))}{OFF}")
    return f"{COLOUR['done']}forgot {_plural(len(gone), 'chat')}{OFF}"


def menu_device(term):
    """Link state and the things you can do about it."""
    while True:
        items = [
            Item("Connection report", value="report",
                 detail="every link, and the shortest fix for whichever is down"),
            Item("Pair a device", value="pair",
                 detail="puts PAIR? on its screen; press GO within 45s"),
            Item("Show the shared token", value="token",
                 detail="for typing into a cordless board's setup portal"),
            Item("Restart the daemon", value="daemon", gap=True),
            Item("Back", value="back", gap=True),
        ]
        got = pick("DEVICE", items, term=term)
        if got is None or got == "back":
            return None
        if got == "daemon":
            problem = start_daemon()
            return (f"{COLOUR['error']}{problem}{OFF}" if problem
                    else f"{COLOUR['done']}daemon restarted{OFF}")
        if got == "pair":
            reply = talk("pair")
            if reply is None:
                return f"{COLOUR['error']}no daemon{OFF}"
            if reply.startswith("error:"):
                return f"{COLOUR['error']}{reply.strip()[7:]}{OFF}"
            return (f"{COLOUR['done']}pairing armed — press GO on the device"
                    f"{OFF}")
        # The two that are genuinely a page of text rather than a choice.
        _foreground(term, [sys.executable,
                           os.path.join(HERE, "claude-mate-connect")]
                    + ([] if got == "report" else ["--token"]))


def _foreground(term, argv):
    """Hand the terminal to another tool, then take it back.

    Only for output that is a PAGE rather than a choice -- the connection
    report, the token. Anything that asks a question belongs in pick(), where
    the keys are the same as everywhere else.
    """
    term.restore()
    try:
        subprocess.call(argv)
        input("\n  press enter to go back ")
    except (OSError, EOFError, KeyboardInterrupt):
        pass
    term.__enter__()


def main(argv):
    if not argv or argv[0] in ("status", "queue", "ls", "list"):
        # THE APP ONLY ON A REAL TERMINAL, and it needs BOTH ends of it. stdout
        # alone is not enough -- the test suite runs the CLI from a developer's
        # terminal and would inherit a TTY stdin -- and stdin alone is not
        # enough either, because CI redirects `< /dev/null`. Piped, cron'd,
        # hooked or tested, this stays the one-shot queue print it always was.
        if not argv and sys.stdin.isatty() and sys.stdout.isatty():
            try:
                return cmd_app()
            except KeyboardInterrupt:
                return 0
        return cmd_status()
    cmd, rest = argv[0], argv[1:]
    if cmd in ("watch", "-w", "--watch"):
        try:
            return cmd_status(watch=True)
        except KeyboardInterrupt:
            print()
            return 0
    if cmd in PRESSES:
        return cmd_press(cmd)
    if cmd == "select":
        if not rest:
            die("claude-mate select: which session? (index or name)")
        return cmd_select(rest[0])
    if cmd in ("accounts", "account"):
        return cmd_accounts(rest)
    if cmd == "history":
        return cmd_history(rest)
    if cmd == "link":
        return cmd_link(rest)
    if cmd == "trust":
        return cmd_trust(rest)
    if cmd in ("app", "ui", "menu"):
        # The app by name, for when stdin is not a terminal but you want it
        # anyway -- and so the thing has a name to put in the documentation.
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            die("claude-mate app: needs a terminal on both stdin and stdout")
        try:
            return cmd_app()
        except KeyboardInterrupt:
            return 0
    if cmd == "daemon":
        if rest and rest[0] not in ("start", "restart"):
            die(f"claude-mate daemon: unknown subcommand {rest[0]!r}")
        problem = start_daemon()
        if problem:
            die(f"claude-mate: {problem}")
        print("daemon running.")
        return 0
    if cmd in ("-V", "--version", "version"):
        print(f"claude-mate {read_version()}")
        return 0
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    die(f"claude-mate: unknown command {cmd!r}. Try --help.")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
