#!/usr/bin/env python3
"""claude-mate-connect -- get a device talking to the daemon, and say why not.

WHY THIS EXISTS. "How do I connect the device after a factory reset" had no
answer you could find from the Mac. The device knew (its glass says
`no token: MENU > Set token`), the daemon knew (`THE DEVICE HAS NO TOKEN`), and
neither was anywhere the person sitting at a terminal would look -- the only
Claude Mate prompt they ever see is the account picker. So this is that missing
screen: one command that reports every link, and tells you the shortest way to
fix whichever one is down.

IT USUALLY HAS NOTHING TO DO. A device on the cable is provisioned by the daemon
automatically the moment the port opens, so the common case here is confirming
that it worked. The command exists for the case where it cannot: a cordless
board, out of reach of any cable, which has to be told its token through the
setup portal it can raise on its own.

WHY THE DEVICE IS NOT IN THE BLUETOOTH PANE, since that is the first place
everyone looks and its absence reads as a fault: the status link is an unpaired
GATT peripheral advertising in short bursts, deliberately -- there is no pairing
step because a Just Works pairing authenticates nobody, and the token handshake
is what actually decides who may drive the device. macOS lists Classic and
pairable devices there, so it will never appear, and connecting it there would
not connect it to the daemon in any case. (The GAMEPAD mode is a real HID
device and does appear -- that is a different role of the same board.)

  claude-mate-connect            # report every link and what to do next
  claude-mate-connect --pair     # enrol an unprovisioned device over BLE
  claude-mate-connect --token    # print the shared token, for typing into the
                                 # device's portal from a phone
"""
import glob
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
LOG = os.path.join(HOME, "Library/Logs/claude-mate.err.log")
PLIST = os.path.join(HOME, "Library/LaunchAgents/com.claudemate.daemon.plist")
TOKEN_FILE = os.path.expanduser(
    os.environ.get("CLAUDE_MATE_TOKEN_FILE", "~/.config/claude-mate/token"))
PORT_GLOBS = ("/dev/cu.usbmodem*", "/dev/cu.usbserial*", "/dev/cu.wchusbserial*")

BOLD, DIM, GREEN, RED, YELLOW, OFF = (
    "\033[1m", "\033[2m", "\033[32m", "\033[31m", "\033[33m", "\033[0m")
if not sys.stdout.isatty():
    BOLD = DIM = GREEN = RED = YELLOW = OFF = ""


def usb_ports():
    return sorted(p for g in PORT_GLOBS for p in glob.glob(g))


def read_token():
    try:
        with open(TOKEN_FILE) as fh:
            return fh.read().strip()
    except OSError:
        return None


def daemon_pid():
    """The LaunchAgent's pid, or None. `launchctl list` prints pid<TAB>status."""
    try:
        out = subprocess.run(["launchctl", "list"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for ln in out.splitlines():
        if "com.claudemate.daemon" in ln:
            pid = ln.split("\t")[0].strip()
            return int(pid) if pid.isdigit() else None
    return None


def tail(n=400):
    try:
        with open(LOG, errors="replace") as fh:
            return fh.read().splitlines()[-n:]
    except OSError:
        return []


def log_size():
    """Where the log ends right now, in bytes."""
    try:
        return os.path.getsize(LOG)
    except OSError:
        return 0


def log_since(offset):
    """Everything written after `offset` bytes.

    BY BYTE OFFSET, NOT BY INDEX INTO A TAIL. The first cut remembered
    `len(tail(2000))` and then read `tail(2000)[that:]` -- which is empty
    forever once the log is longer than the window, and this log is 400,000
    lines. So a pairing that had ALREADY SUCCEEDED was invisible to the thing
    waiting for it: the daemon wrote `paired`, and the terminal sat for 75 s and
    then reported no answer. Reported as "paired but it is not obvious", which
    was generous.
    """
    try:
        with open(LOG, errors="replace") as fh:
            fh.seek(offset)
            return fh.read().splitlines()
    except OSError:
        return []


def ble_state(lines):
    """The last thing the daemon said about BLE, as (state, detail).

    Read backwards from the log rather than by scanning ourselves: two
    CoreBluetooth scans on one Mac fight, and the daemon's is the one that
    matters. Its log is also the ONLY place the Mac can answer "is the device
    advertising" -- see the note about the Bluetooth pane above.
    """
    for ln in reversed(lines):
        if "BLE device connected" in ln:
            return "linked", ln.split("BLE device connected:")[-1].strip()
        if "THE DEVICE HAS NO TOKEN" in ln:
            return "notoken", ""
        if "token rejected" in ln:
            return "rejected", ""
        if "no device found yet" in ln:
            return "searching", ""
        if "bleak" in ln and "install" in ln:
            return "nobleak", ln.strip()
    return "unknown", ""


def arm_pairing():
    """Ask the daemon to enrol the next unprovisioned device it connects to.

    Through the daemon rather than from here, because the daemon owns the radio:
    a second CoreBluetooth scanner on the same Mac fights the first, and the
    connection this needs is one the daemon already has open.
    """
    import socket
    # Same default as the daemon's DEFAULT_SOCK, and the same env var, so the
    # two cannot drift into looking for each other in different places.
    path = os.environ.get("CLAUDE_MATE_SOCK", "/tmp/claude-mate.sock")
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(5)
        c.connect(path)
        c.sendall(b"pair\n")
        # READ THE ANSWER. Closing here threw away the daemon's
        # "error: BLE is not running" as an EPIPE, so a daemon with no radio was
        # reported as a device out of range -- 75 seconds of waiting for a prompt
        # that was never going to appear, and neither cause named. The reply
        # exists precisely to surface the failure a terminal cannot otherwise see.
        c.shutdown(socket.SHUT_WR)
        reply = b""
        while True:
            chunk = c.recv(4096)
            if not chunk:
                break
            reply += chunk
        c.close()
        reply = reply.decode("utf-8", errors="replace").strip()
        if reply.startswith("error:"):
            return False, reply[7:].strip()
        return True, path
    except OSError as e:
        return False, f"{path}: {e}"


def pair():
    """Drive an enrolment and report what happened, by watching the log."""
    if daemon_pid() is None:
        print(f"{RED}The daemon is not running.{OFF}  launchctl bootstrap "
              f"gui/{os.getuid()} {PLIST}")
        return 1
    where = log_size()               # only judge lines written from here on
    ok, detail = arm_pairing()
    if not ok:
        print(f"{RED}Cannot pair:{OFF} {detail}")
        return 1

    print(f"\n{BOLD}Look at the device: it is asking whether to pair.{OFF}")
    print(f"  {DIM}press GO to accept — any other button, or 45s, declines{OFF}\n")

    # Poll the log rather than the device: the daemon is the only thing holding
    # a connection to it, so the daemon's account is the only one there is.
    deadline = time.time() + 75
    while time.time() < deadline:
        for ln in log_since(where):
            if "paired" in ln and "the device now has" in ln:
                print(f"{GREEN}{BOLD}  ✓  PAIRED{OFF}  the device has the token "
                      f"and is linking now\n")
                # Wait for the link itself, so "paired" is not the last word on a
                # device that then fails to connect for some other reason.
                until = time.time() + 20
                while time.time() < until:
                    if any("BLE device connected" in l for l in log_since(where)):
                        print(f"{GREEN}  ✓  LINKED{OFF}  the daemon is talking "
                              f"to it now\n")
                        return 0
                    time.sleep(0.5)
                print(f"{YELLOW}  ..  still connecting.{OFF} Give it a few "
                      f"seconds and run `claude-mate-connect`.\n")
                return 0
            if "pairing timed out" in ln:
                print(f"{RED}Nobody pressed GO{OFF} — the device declined by "
                      "timing out. Run this again when you are next to it.")
                return 1
            if "pairing declined" in ln:
                print(f"{RED}Declined on the device.{OFF}")
                return 1
            if "did not take the token" in ln:
                print(f"{RED}The device refused the token.{OFF} {DIM}{ln.strip()}{OFF}")
                return 1
        time.sleep(0.5)
    print(f"{YELLOW}No answer within 75s.{OFF} If the device never lit up, it "
          "may be out of range\nor already provisioned — run "
          "`claude-mate-connect` to see where it stands.")
    return 1


def say(ok, label, detail=""):
    mark = f"{GREEN}ok{OFF}" if ok is True else (
        f"{RED}no{OFF}" if ok is False else f"{YELLOW}??{OFF}")
    print(f"  [{mark}] {label}" + (f"  {DIM}{detail}{OFF}" if detail else ""))


def main():
    if "--pair" in sys.argv[1:]:
        return pair()
    if "--token" in sys.argv[1:]:
        tok = read_token()
        if not tok:
            print(f"no token at {TOKEN_FILE}", file=sys.stderr)
            return 1
        print(tok)
        return 0

    print(f"\n{BOLD}claude-mate — device connection{OFF}\n")

    pid = daemon_pid()
    say(pid is not None, "daemon running",
        f"pid {pid}" if pid else "start it: launchctl bootstrap "
                                 f"gui/{os.getuid()} {PLIST}")

    token = read_token()
    say(token is not None, "shared token exists",
        TOKEN_FILE if token else f"none at {TOKEN_FILE}")

    ports = usb_ports()
    say(bool(ports), "device on the cable",
        ports[0] if ports else "not plugged in (that is fine — see below)")

    lines = tail()
    state, detail = ble_state(lines)
    say({"linked": True, "searching": None, "unknown": None}.get(state, False),
        "BLE link",
        {"linked": f"connected {detail}",
         "notoken": "the device has no token yet",
         "rejected": "the device holds a DIFFERENT token",
         "searching": "scanning — nothing found yet",
         "nobleak": detail,
         "unknown": "nothing in the log yet"}[state])

    print()
    if state == "linked":
        print(f"{GREEN}Connected.{OFF} Nothing to do.")
        return 0

    if ports:
        # The daemon hands its token to whatever opens on the cable, so this is
        # already in flight or already done; the only thing left is to make sure
        # the daemon actually has the port.
        print(f"{BOLD}The cable does this for you.{OFF} The daemon gives its "
              f"token to any device that\nappears on {ports[0]} the moment it "
              "opens the port. If the link is still down:\n")
        if pid is None:
            print(f"  launchctl bootstrap gui/{os.getuid()} {PLIST}")
        else:
            print("  # something else may be holding the port — bounce the daemon")
            print(f"  launchctl kickstart -k gui/{os.getuid()}/com.claudemate.daemon")
        print("\nThen give it a few seconds and run this again.")
        return 0

    # No cable. PAIRING is the answer here, and it is offered rather than
    # explained: the fallback below involves an access point, a phone and
    # transcribing a secret, and nobody should be sent down that road first.
    if state == "notoken":
        print(f"{BOLD}It needs pairing.{OFF} That is one button on the device — "
              "no cable, no Wi-Fi,\nno typing.\n")
        try:
            ans = input("  pair it now? [Y/n] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
        if ans in ("", "y", "yes"):
            return pair()
        print("\nOr, the long way round: SETTINGS → Set token on the device "
              "raises an access\npoint; join it from a phone, open "
              "http://192.168.4.1, paste the token below,\nand leave Network "
              "as (none).")
        if token:
            print(f"\n  the token       {BOLD}{token}{OFF}")
        return 0

    print(f"{BOLD}Plug it in, or pair it.{OFF}\n")
    print("  claude-mate-connect --pair    then press GO on the device")
    print("  (or plug in the cable — the daemon provisions it on its own)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
